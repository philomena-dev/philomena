<div class="flex flex--column flex--spaced-out flex--centered flex--no-wrap center dr__image-cell">
  <p>
    <%= if is_nil(@image) do %>(Image now hard-deleted)<% else %>#{@image.id}<% end %>
  </p>
  <div class="dupe-report-list--image-container">{render PhilomenaWeb.ImageView, "_image_container.html", image: @image, size: :thumb_small, conn: @conn}</div>
  <p>{@image.image_width}x{@image.image_height}</p>
  <p>{render PhilomenaWeb.UserAttributionView, "_anon_user.html", object: @image, conn: @conn}</p>
  <%= if can?(@conn, :accept, @report) and mergeable?(@report) do %>
    <%= if @source do %>
      <%= form_for @conn, ~p"/duplicate_reports/#{@report}/accept_reverse", [method: "post", class: "button_to js-duplicate-report", data: [remote: "true"]], fn _f -> %><button class="button button--separate-right" data-disable-with="Loading…" type="submit">Keep Source <i class="fa fa-arrow-left"></i></button><% end %>
    <% else %>
      <%= form_for @conn, ~p"/duplicate_reports/#{@report}/accept", [method: "post", class: "button_to js-duplicate-report", data: [remote: "true"]], fn _f -> %><button class="button button--separate-right" data-disable-with="Loading…" type="submit"><i class="fa fa-arrow-right"></i> Keep Target</button><% end %>
    <% end %>
  <% end %>
</div>
