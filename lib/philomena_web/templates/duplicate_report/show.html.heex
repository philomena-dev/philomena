<% source_url = comparison_url(@conn, @duplicate_report.image)
target_url = comparison_url(@conn, @duplicate_report.duplicate_of_image)

{width, height} =
  largest_dimensions([@duplicate_report.image, @duplicate_report.duplicate_of_image]) %>
<div class="button-group separated">
  <a class="button button-success js-comparison-button" href={source_url} target="_blank">Open source file</a>
  <a class="button button-success js-comparison-button" href={target_url} target="_blank">Open target file</a>
  <div class="flex-1"></div>
  <a class="button js-comparison-button" href="#subtractive">Subtractive</a>
  <a class="button js-comparison-button" href="#swipe">Swipe</a>
  <a class="button js-comparison-button" href="#onion-skin">Onion skin</a>
</div>
<h1>Difference</h1>
<div class="difference" id="subtractive">
  <svg class="difference-image" height={height} width={width} viewBox={"0 0 #{width} #{height}"}><defs>
    <filter id="overlay-diff">
      <feImage
        crossorigin="anonymous"
        height="100%"
        id="source"
        result="source"
        width="100%"
        x="0"
        xlink:href={source_url}
        y="0"
      >
      </feImage>
      <feImage
        crossorigin="anonymous"
        height="100%"
        id="target"
        result="target"
        width="100%"
        x="0"
        xlink:href={target_url}
        y="0"
      >
      </feImage>
      <feBlend in="source" in2="target" mode="difference" result="diff"></feBlend>
      <%!-- Contrast-boost matrix = (5I|0) [4x5] --%>
      <feColorMatrix in="diff" type="matrix" values="5 0 0 0 0  0 5 0 0 0  0 0 5 0 0  0 0 0 5 0">
      </feColorMatrix>
    </filter>
  </defs>
  <rect filter="url(#overlay-diff)" height={height} width={width}></rect></svg>
</div>
<h1>Swipe</h1>
<div class="swipe" id="swipe">
  <svg class="swipe-image" height={height} width={width} viewBox={"0 0 #{width} #{height}"}><defs>
    <pattern height="16" id="checkerboard" patternUnits="userSpaceOnUse" width="16">
      <rect fill="#ffffff44" height="8" width="8" x="0" y="0"></rect>
      <rect fill="#00000044" height="8" width="8" x="0" y="8"></rect>
      <rect fill="#00000044" height="8" width="8" x="8" y="0"></rect>
      <rect fill="#ffffff44" height="8" width="8" x="8" y="8"></rect>
    </pattern>
    <clipPath id="clip">
      <rect height={height} width={div(width, 2)}></rect>
    </clipPath>
  </defs>
  <rect fill="url(#checkerboard)" height={height} width={width}></rect>
  <image crossorigin="anonymous" height="100%" id="target" width="100%" xlink:href={target_url}>
  </image>
  <image
    clip-path="url(#clip)"
    crossorigin="anonymous"
    height="100%"
    id="source"
    width="100%"
    xlink:href={source_url}
  >
  </image>
  <rect
    fill="#000"
    height={height}
    id="divider"
    stroke="#fff"
    stroke-width="1"
    width="3"
    x={div(width, 2)}
  >
  </rect></svg>
</div>
<h1>Onion Skin</h1>
<div class="onion-skin" id="onion-skin">
  <svg class="onion-skin-image" height={height} width={width} viewBox={"0 0 #{width} #{height}"}><defs>
    <pattern height="16" id="checkerboard" patternUnits="userSpaceOnUse" width="16">
      <rect fill="#ffffff44" height="8" width="8" x="0" y="0"></rect>
      <rect fill="#00000044" height="8" width="8" x="0" y="8"></rect>
      <rect fill="#00000044" height="8" width="8" x="8" y="0"></rect>
      <rect fill="#ffffff44" height="8" width="8" x="8" y="8"></rect>
    </pattern>
  </defs>
  <rect fill="url(#checkerboard)" height={height} width={width}></rect>
  <image crossorigin="anonymous" height="100%" id="source" width="100%" xlink:href={source_url}>
  </image>
  <image crossorigin="anonymous" height="100%" id="target" width="100%" xlink:href={target_url}>
  </image></svg>
  <div class="onion-skin-controls">
    <input class="slider flex-1 js-onion-skin-slider" max="1" min="0" step="0.01" type="range" /><button class="button js-onion-skin-button">0%</button><button class="button js-onion-skin-button">100%</button>
  </div>
</div>
<a class="button" data-click-toggle="#comparison-help" href="#">Toggle help</a>
<section class="hidden" id="comparison-help">
  <p>Left is source, right is target.</p>
  <p>File links open in a new tab. Hold Ctrl, or middle-click, to open without focusing.</p>
  <h2>Key bindings</h2>
  <div class="table-wrap responsive">
    <table class="table striped">
      <thead>
        <tr>
          <th>Key</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><code class="code-span">j</code></td>
          <td>Jump to subtractive difference</td>
        </tr>
        <tr>
          <td><code class="code-span">k</code></td>
          <td>Jump to swipe difference</td>
        </tr>
        <tr>
          <td><code class="code-span">l</code></td>
          <td>Jump to onion skin difference</td>
        </tr>
        <tr>
          <td><code class="code-span">,</code> (comma)</td>
          <td>Set onion skin slider to 0%</td>
        </tr>
        <tr>
          <td><code class="code-span">.</code> (period)</td>
          <td>Set onion skin slider to 100%</td>
        </tr>
      </tbody>
    </table>
  </div>
</section>
