<h1>Duplicate Reports</h1>
<%= form_for @changeset, ~p"/duplicate_reports", [as: :dq, method: :get], fn f -> %>
  <div class="flex flex-wrap items-center gap-md">
    <%= for {label, state} <- states() do %>
      <input
        checked={Enum.member?(f.data.states, state)}
        class="button-check-input"
        id={input_id(f, :states, state)}
        name={"#{input_name(f, :states)}[]"}
        type="checkbox"
        value={state}
      /><label
        class="button"
        for={input_id(f, :states, state)}
      >{label}</label>
    <% end %>
    {select_field(f, :sd, sorts())}{submit("Search",
      class: "button button-primary"
    )}
  </div>
  <div class="errors">{error_tag(f, :states)}{error_tag(f, :sd)}</div>
<% end %>
<%= if @duplicate_reports do %>
  <% route = fn p -> ~p"/duplicate_reports?#{p}" end %>
  <% pagination =
    render(PhilomenaWeb.PaginationView, "_pagination.html",
      page: @duplicate_reports,
      route: route,
      conn: @conn,
      params: [dq: @conn.params["dq"]]
    ) %>
  <div class="block">
    <div :if={multiple_pages?(@duplicate_reports)} class="block-header">
      {pagination}
    </div>
    <div class="block-content">
      {render(PhilomenaWeb.DuplicateReportView, "_list.html",
        duplicate_reports: @duplicate_reports,
        conn: @conn
      )}
    </div>
    <div :if={multiple_pages?(@duplicate_reports)} class="block-header sub">
      {pagination}
    </div>
  </div>
<% end %>
