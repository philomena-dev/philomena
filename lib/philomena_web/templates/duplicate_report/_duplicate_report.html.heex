<tr class={"duplicate-report-#{@report.id}"}>
  <td>
    {render(PhilomenaWeb.DuplicateReportView, "_image_cell.html",
      image: @report.image,
      source: true,
      report: @report,
      conn: @conn
    )}
  </td>
  <td>
    {render(PhilomenaWeb.DuplicateReportView, "_image_cell.html",
      image: @report.duplicate_of_image,
      source: false,
      report: @report,
      conn: @conn
    )}
  </td>
  <td class="whitespace-nowrap">
    <div class="table-wrap">
      <table class="table">
        <tbody>
          <tr>
            <%= if same_aspect_ratio?(@report) do %>
              <td class="table-success">
                <a href={~p"/duplicate_reports/#{@report}"} phx-no-format>Visual diff </a>(Same aspect ratio)
              </td>
            <% else %>
              <td class="table-warning">Different aspect ratio</td>
            <% end %>
          </tr>
          <tr>
            <%= cond do %>
              <% both_are_edits?(@report) -> %>
                <td class="table-warning">Both are edits</td>
              <% target_is_edit?(@report) -> %>
                <td class="table-danger">Target is an edit</td>
              <% source_is_edit?(@report) -> %>
                <td class="table-danger">Source is an edit</td>
              <% true -> %>
                <td class="table-success">Neither is an edit</td>
            <% end %>
          </tr>
          <tr>
            <%= cond do %>
              <% both_are_alternate_versions?(@report) -> %>
                <td class="table-warning">Both are alternate versions</td>
              <% target_is_alternate_version?(@report) -> %>
                <td class="table-danger">Target is an alternate version</td>
              <% source_is_alternate_version?(@report) -> %>
                <td class="table-danger">Source is an alternate version</td>
              <% true -> %>
                <td class="table-success">Neither is an alternate version</td>
            <% end %>
          </tr>
          <tr>
            <%= cond do %>
              <% same_res?(@report) -> %>
                <td class="table-success">Same resolution</td>
              <% higher_res?(@report) -> %>
                <td class="table-warning">Target resolution better</td>
              <% true -> %>
                <td class="table-warning">Source resolution better</td>
            <% end %>
          </tr>
          <tr>
            <%= cond do %>
              <% same_format?(@report) -> %>
                <td class="table-success">Same format {file_types(@report)}</td>
              <% better_format?(@report) -> %>
                <td class="table-warning">Target format better {file_types(@report)}</td>
              <% true -> %>
                <td class="table-warning">Source format better {file_types(@report)}</td>
            <% end %>
          </tr>
          <tr>
            <%= cond do %>
              <% same_artist_tags?(@report) -> %>
                <td class="table-success">Same artist tags</td>
              <% more_artist_tags_on_target?(@report) -> %>
                <td class="table-warning">More artist tags on target</td>
              <% more_artist_tags_on_source?(@report) -> %>
                <td class="table-warning">More artist tags on source</td>
              <% true -> %>
                <td class="table-danger">Different artist tags</td>
            <% end %>
          </tr>
          <tr>
            <%= cond do %>
              <% neither_have_source?(@report) -> %>
                <td class="table-warning">Neither have sources</td>
              <% same_source?(@report) -> %>
                <td class="table-success">Same sources</td>
              <% similar_source?(@report) -> %>
                <td class="table-warning">Same hostname</td>
              <% source_on_target?(@report) -> %>
                <td class="table-warning">Target has a source</td>
              <% source_on_source?(@report) -> %>
                <td class="table-warning">Source has a source</td>
              <% true -> %>
                <td class="table-danger">Different sources</td>
            <% end %>
          </tr>
          <tr>
            <%= if same_rating_tags?(@report) do %>
              <td class="table-success">Same rating tags</td>
            <% else %>
              <td class="table-danger">Different rating tags</td>
            <% end %>
          </tr>
          <tr>
            <%= cond do %>
              <% not source_approved?(@report) -> %>
                <td class="table-danger">Source is not approved</td>
              <% not target_approved?(@report) -> %>
                <td class="table-danger">Target is not approved</td>
              <% forward_merge?(@report) -> %>
                <td class="table-warning">Target newer</td>
              <% true -> %>
                <td class="table-success">Target older</td>
            <% end %>
          </tr>
        </tbody>
      </table>
    </div>
  </td>
  <td class="flex flex-col" id={"report_options_#{@report.id}"}>
    <div class={["p-md", state_class(@report)]}>
      {String.capitalize(@report.state)}
      <%= if can?(@conn, :accept, @report) and not is_nil(@report.modifier) do %>
        by {@report.modifier.name}
      <% end %>
      <%= if can?(@conn, :accept, @report) do %>
        <div phx-no-format>
          <%= if @report.state == "open" do %><%= form_for @conn, ~p"/duplicate_reports/#{@report}/claim",
                [method: "post", class: "button-to js-duplicate-report", data: [remote: "true"]], fn _f -> %><button
                class="button me-md" data-disable-with="Loading…" type="submit"
              ><i class="fa fa-clipboard"></i> Claim</button><% end %><% end %><%= if @report.state == "claimed" do %><%= form_for @conn, ~p"/duplicate_reports/#{@report}/claim",
                [method: "delete", class: "button-to js-duplicate-report", data: [remote: "true"]], fn _f -> %><button
                class="button me-md" data-disable-with="Loading…" type="submit"
              ><i class="fa fa-clipboard"></i> Release</button><% end %><% end %><%= if @report.state in ~w(open claimed) do %><%= form_for @conn, ~p"/duplicate_reports/#{@report}/reject",
                [method: "post", class: "button-to js-duplicate-report", data: [remote: "true"]], fn _f -> %><button
                class="button me-md" data-disable-with="Loading…" type="submit"
              ><i class="fa fa-times"></i> Reject</button><% end %><% end %>
        </div>
      <% end %>
    </div>
    <div class="p-md">
      <div>
        Reported {pretty_time(@report.created_at)}
        <%= if can?(@conn, :accept, @report) and @report.user do %>
          by {link(@report.user.name, to: ~p"/profiles/#{@report.user}")}
        <% end %>
      </div>
      {escape_nl2br(@report.reason)}
    </div>
  </td>
</tr>
