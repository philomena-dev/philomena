<h1>Viewing details of {@rule.name}</h1>
<p>
  <a href={~p"/rules"}><i class="fa fa-chevron-left"></i> Back to Rules List</a>
</p>
<br />{render(PhilomenaWeb.RuleView, "_rule.html", conn: @conn, rule: @rule, show_timestamp: true)}
<h2>Revision History</h2>
<%= if Enum.count(@versions) == 0 do %>
  <p>
    Revision history for this rule is unavailable, as this is the initial version of this rule. Once this rule is updated, differences between revisions will be shown here.
  </p>
<% else %>
  <table class="table">
    <thead>
      <tr>
        <th>User</th>
        <th>When</th>
        <th>Difference</th>
      </tr>
    </thead>
    <tbody>
      <%= for version <- @versions do %>
        <tr>
          <td>
            <%= if version.user do %>
              {link(version.user.name, to: ~p"/profiles/#{version.user}")}
            <% else %>
              System
            <% end %>
          </td>
          <td>{pretty_time(version.created_at)}</td>
          <td>{render(PhilomenaWeb.RuleView, "_rulediff.html", version: version)}</td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
