<h1>Resend confirmation instructions</h1>
<%= form_for :user, ~p"/confirmations", [class: "content"], fn f -> %>
  <div class="form-control">
    {email_input(f, :email, placeholder: "Email", class: "input-field", required: true)}
  </div>
  {render(PhilomenaWeb.CaptchaView, "_captcha.html", name: "confirmation", conn: @conn)}
  <div class="form-control-submit">
    {submit("Resend confirmation instructions", class: "button")}
  </div>
<% end %>
