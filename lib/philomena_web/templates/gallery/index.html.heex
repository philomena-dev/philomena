<div class="layout-columns">
  <div class="layout-side">
    <div class="block">
      <div class="block-content">
        <h3>Search Galleries</h3>
        <%= form_for @changeset, ~p"/galleries", [as: :gallery, method: "get", class: "content"], fn f -> %>
          <div class="form-control">
            {label(f, :title, "Title")}
            {text_input(f, :title,
              class: "input-field full-width",
              placeholder: "Gallery title (* as wildcard)"
            )}
          </div>
          <div class="form-control">
            {label(f, :description, "Description")}
            {textarea(f, :description,
              class: "input-field full-width",
              placeholder: "Gallery description"
            )}
          </div>
          <div class="form-control">
            {label(f, :creator, "Creator")}
            {text_input(f, :creator,
              class: "input-field full-width",
              placeholder: "Gallery creator (exact match)"
            )}
          </div>
          <div class="form-control">
            {label(f, :include_image, "Include image")}
            {number_input(f, :include_image,
              class: "input-field full-width",
              placeholder: "Image ID (e.g. 100)"
            )}
          </div>
          <div class="form-control">
            {label(f, :sf, "Sort by")}
            <div class="flex flex-wrap gap-md">
              {select_field(
                f,
                :sf,
                "Creation date": "created_at",
                "Modification date": "updated_at",
                "Image count": "image_count",
                "Subscriber count": "subscriber_count",
                Relevance: "_score"
              )}{select_field(f, :sd, Descending: "desc", Ascending: "asc")}
            </div>
          </div>
          {error_tag(f, :include_image)}{error_tag(f, :sf)}{error_tag(f, :sd)}
          <div class="form-control-submit">
            {submit("Search", class: "button button-primary")}
          </div>
        <% end %>
      </div>
    </div>
    <div class="block">
      <div class="block-header">
        <a href="/galleries/new" title="Create Gallery">Create Gallery</a>
      </div>
    </div>
  </div>
  <div class="layout-main">
    <div class="block">
      <%= if not is_nil(@galleries) and Enum.any?(@galleries) do %>
        <% route = fn p -> ~p"/galleries?#{p}" end %>
        <% pagination =
          render(PhilomenaWeb.PaginationView, "_pagination.html",
            page: @galleries,
            route: route,
            params: [gallery: @conn.params["gallery"]]
          ) %>
        <div :if={multiple_pages?(@galleries)} class="block-header">
          {pagination}
        </div>
        <div class="block-content media-list">
          <%= for gallery <- @galleries do %>
            {render(PhilomenaWeb.GalleryView, "_gallery.html", gallery: gallery, conn: @conn)}
          <% end %>
        </div>
        <div :if={multiple_pages?(@galleries)} class="block-header sub">
          {pagination}
        </div>
      <% else %>
        <div class="block-content">
          <div class="alert alert-warning">
            No galleries found!
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
