<% link = ~p"/galleries/#{@gallery}" %>
<div class="media-box">
  <div class="media-box-header"><a href={link} title={@gallery.title}>{@gallery.title}</a></div>
  {render(PhilomenaWeb.ImageView, "_image_container.html",
    image: @gallery.thumbnail,
    size: :thumb,
    class: "media-box-content",
    notice: @gallery.spoiler_warning,
    conn: @conn,
    link: link
  )}
</div>
