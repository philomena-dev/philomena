<%= form_for @changeset, @action, [class: "content"], fn f -> %>
  {error_summary(@changeset)}
  <div class="form-control">
    {label(f, :title, "Choose a title displayed in gallery preview")}{text_input(f, :title,
      class: "input-field full-width",
      placeholder: "Title",
      required: true
    )}{error_tag(f, :title)}
  </div>
  <div class="form-control">
    {label(
      f,
      :spoiler_warning,
      "If you are going to have NSFW images in the gallery, leave a warning for users who may not want to see it"
    )}{text_input(f, :spoiler_warning,
      class: "input-field full-width",
      placeholder: "Spoiler warning"
    )}{error_tag(
      f,
      :spoiler_warning
    )}
  </div>
  <div class="form-control">
    {label(:description, "Describe the gallery in a few words")}{textarea(f, :description,
      class: "input-field full-width",
      placeholder: "Description"
    )}{error_tag(f, :description)}
  </div>
  <div class="form-control">
    {label(f, :thumbnail_id, "Set an existing image as the gallery cover")}{number_input(
      f,
      :thumbnail_id,
      class: "input-field",
      placeholder: "Image ID (e.g. 100)",
      min: 0
    )}{error_tag(f, :thumbnail_id)}
  </div>
  {checkbox_field(
    f,
    :order_position_asc,
    "Reverse gallery order (images will be inserted at the end of the gallery)"
  )}{error_tag(f, :order_position_asc)}
  <div class="form-control">
    {checkbox_field(f, :anonymous, "Anonymous")}
    <p class="form-message form-message-description">
      Anonymous galleries are accessible to others, but they won't reveal you as the creator and won't appear on your profile.
    </p>
    {error_tag(f, :anonymous)}
  </div>
  <div class="form-control-submit">{submit("Save Gallery", class: "button")}</div>
<% end %>
