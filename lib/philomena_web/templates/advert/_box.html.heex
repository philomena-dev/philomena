<div class="card spns">
  <div class="spns-text">
    Interested in advertising on Derpibooru? {link("Click here", to: "/pages/advertising")} for information!
  </div>
  <a class="spns-link" href={~p"/adverts/#{@advert}"} rel="nofollow" title={@advert.title}><img
    alt={@advert.title}
    src={advert_image_url(@advert)}
  /></a>
  <p>
    <strong>Derpibooru costs over $25 a day to operate - {link("help support us financially",
      to: "/pages/donations"
    )}!</strong>
  </p>
</div>
