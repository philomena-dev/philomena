<h1>Viewing full filter details for {@filter.name}</h1>
<div class="card">
  <div class="flex flex-wrap items-center gap-md">
    <span>
      Spoilers {number_with_delimiter(length(@filter.spoilered_tag_ids))} {pluralize(
        "tag",
        "tags",
        length(@filter.spoilered_tag_ids)
      )} and hides {number_with_delimiter(length(@filter.hidden_tag_ids))} {pluralize(
        "tag",
        "tags",
        length(@filter.hidden_tag_ids)
      )}
    </span>
    <%= if @filter.id == @conn.assigns.current_filter.id do %>
      <strong>Your current filter</strong>
    <% else %>
      {button_to("Use this filter", ~p"/filters/current?#{[id: @filter]}",
        method: "put",
        class: "button"
      )}
    <% end %>
    <%= if can?(@conn, :edit, @filter) do %>
      {link("Edit this filter", to: ~p"/filters/#{@filter}/edit", class: "button")}
    <% end %>
    <%= if can?(@conn, :delete, @filter) do %>
      {button_to("Destroy this filter", ~p"/filters/#{@filter}",
        method: "delete",
        class: "button",
        data: [confirm: "Are you really, really sure?"]
      )}
    <% end %>
  </div>
  <%= if @filter.user do %>
    <p>
      This filter is maintained by {render(PhilomenaWeb.UserAttributionView, "_user.html",
        object: @filter,
        conn: @conn
      )}
    </p>
  <% end %>
  <p>{@filter.description}</p>
  <%= if Enum.any?(@spoilered_tags) or @filter.spoilered_complex_str not in [nil, ""] do %>
    <h5>This filter spoilers...</h5>
    <div :if={Enum.any?(@spoilered_tags)} class="tag-list">
      <%= for tag <- @spoilered_tags do %>
        {render(PhilomenaWeb.TagView, "_tag.html", tag: tag, conn: @conn)}
      <% end %>
    </div>
    <pre :if={@filter.spoilered_complex_str not in [nil, ""]} class="code-block wrap">{@filter.spoilered_complex_str}</pre>
  <% else %>
    <p>This filter doesn't spoiler any tags.</p>
  <% end %>
  <%= if Enum.any?(@hidden_tags) or @filter.hidden_complex_str not in [nil, ""] do %>
    <h5>This filter hides...</h5>
    <div :if={Enum.any?(@hidden_tags)} class="tag-list">
      <%= for tag <- @hidden_tags do %>
        {render(PhilomenaWeb.TagView, "_tag.html", tag: tag, conn: @conn)}
      <% end %>
    </div>
    <pre :if={@filter.hidden_complex_str not in [nil, ""]} class="code-block wrap">{@filter.hidden_complex_str}</pre>
  <% else %>
    <p>This filter doesn't hide any tags.</p>
  <% end %>
</div>
<%!-- p = link("Report filter to moderators", new_report_path(reportable_class: 'filter', reportable_id: @filter.id) --%>
<p>{link("Back to filters", to: ~p"/filters")}</p>
