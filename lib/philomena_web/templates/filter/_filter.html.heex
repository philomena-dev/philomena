<div class="filter">
  <h3>{@filter.name}</h3>
  <%= if @filter.user do %>
    <p>Maintained by {render PhilomenaWeb.UserAttributionView, "_user.html", object: @filter, conn: @conn}</p>
  <% end %>
  <%= if @filter.system do %>
    <p>Maintained by staff </p>
  <% end %>
  <div class="filter-options">
    <ul>
      <li phx-no-format>Spoilers {length(@filter.spoilered_tag_ids)}, hides {length(@filter.hidden_tag_ids)}</li><li phx-no-format>{link "View this filter", to: ~p"/filters/#{@filter}", class: "button"}</li><li phx-no-format>{link "Copy and Customize", to: ~p"/filters/new?#{[based_on: @filter]}", class: "button"}</li><li :if={can?(@conn, :edit, @filter)} phx-no-format>{link "Edit this filter", to: ~p"/filters/#{@filter}/edit", class: "button"}</li><li :if={@filter.id == @conn.assigns.current_filter.id} phx-no-format><strong>Your current filter</strong></li><li :if={!(@filter.id == @conn.assigns.current_filter.id)} phx-no-format>{button_to "Use this filter", ~p"/filters/current?#{[id: @filter]}", method: "put", class: "button"}</li>
    </ul>
    <p><em>{@filter.description}</em></p>
  </div>
</div>
