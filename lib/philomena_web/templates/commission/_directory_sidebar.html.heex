<div class="block">
  <div class="block-header"><span class="block-header-title">Search</span></div>
  <div class="block-content">
    <%= form_for @changeset, ~p"/commissions", [as: :commission, method: "get", class: "content"], fn f -> %>
      <span>Art Categories:</span>
      <%= for {name, _value} <- categories() do %>
        <% checked =
          Atom.to_string(name) in (Ecto.Changeset.get_field(@changeset, :category) || []) %>
        {checkbox_field(f, name, name,
          checked_value: name,
          checked: checked,
          name: "commission[category][]",
          hidden_input: false
        )}
      <% end %>
      <div class="form-control">
        {label(f, :item_type, "Commission Type:")}{select_field(f, :item_type, types())}
      </div>
      <div class="form-control">
        {label(f, :price_min, "Price:")}{number_input(f, :price_min,
          class: "input-field",
          placeholder: "At Least",
          step: "any",
          min: 0
        )}{number_input(f, :price_max,
          class: "input-field",
          placeholder: "At Most",
          step: "any",
          min: 0
        )}
      </div>
      <div class="form-control">
        {label(f, :keywords, "Search:")}{text_input(f, :keywords,
          class: "input-field",
          placeholder: "Keywords"
        )}
      </div>
      <div class="form-control-submit">{submit("Search", class: "button")}</div>
    <% end %>
  </div>
</div>
