<div class="block">
  <div class="block-header"><span class="block-header-title">Search</span></div>
  <div class="block-content">
    <%= form_for @changeset, ~p"/commissions", [as: :commission, method: "get", class: "hform"], fn f -> %>
      <div class="field">{label(f, :categories, "Art Categories:")}</div>
      <%= for {name, _value} <- categories() do %>
        <% checked =
          Atom.to_string(name) in (Ecto.Changeset.get_field(@changeset, :category) || []) %>
        <div class="field">
          {checkbox(f, name,
            checked_value: name,
            checked: checked,
            name: "commission[category][]",
            class: "checkbox me-lg",
            hidden_input: false
          )} {label(f, name, name)}
        </div>
      <% end %>
      <br />
      <div class="field">{label(f, :item_type, "Commission Type:")}</div>
      <div class="field">{select_field(f, :item_type, types())}</div>
      <br />
      <div class="field">{label(f, :price_min, "Price:")}</div>
      <div class="field">
        {number_input(f, :price_min,
          class: "input-field",
          placeholder: "At Least",
          step: "any",
          min: 0
        )}
      </div>
      <div class="field">
        {number_input(f, :price_max,
          class: "input-field",
          placeholder: "At Most",
          step: "any",
          min: 0
        )}
      </div>
      <br />
      <div class="field">{label(f, :keywords, "Search:")}</div>
      <div class="field">
        {text_input(f, :keywords, class: "input-field", placeholder: "Keywords")}
      </div>
      {submit("Search", class: "button")}
    <% end %>
  </div>
</div>
