<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="IE=edge" http-equiv="X-UA-Compatible" />
    {viewport_meta_tag(@conn)}
    <title phx-no-format>{@status} - Philomena</title>
    <link href={~p"/css/application.css"} rel="stylesheet" />
    <link href="/favicon.ico" rel="icon" type="image/x-icon" />
    <link href="/favicon.svg" rel="icon" type="image/svg+xml" />
  </head>
  <body class="page-minimal">
    <main class="card">
      <h1 class="card-header"><i class="fa-fw favicon-home"></i> Philomena</h1>
      <h3>{@short_msg}</h3>
      <p>{@long_msg}</p>
    </main>
  </body>
</html>
