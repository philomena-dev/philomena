<div class="block" id="imagelist-container">
  <div class="block-header">
    <div class="block-header-title hidden-below-md">
      Viewing related images for
      <%= link to: ~p"/images/#{@image}" do %>
        image #{@image.id}
      <% end %>
    </div>
  </div>
  <div class="block-content media-list">
    <%= for image <- @images do %>
      {render(PhilomenaWeb.ImageView, "_image_box.html",
        image: image,
        link: ~p"/images/#{image}",
        size: :thumb,
        conn: @conn
      )}
    <% end %>
  </div>
</div>
