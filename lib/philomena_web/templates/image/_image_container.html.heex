<% link = assigns[:link] || ~p"/images/#{@image}"
intent = render_intent(@conn, @image, @size)
webm? = match?({:image, _, _}, intent) and @image.image_mime_type == "video/webm" %>
<div
  class={["image-container", to_string(@size), assigns[:class]]}
  {[data: image_container_data(@conn, @image, @size)]}
>
  <%= case intent do %>
    <% {:hidpi, small_url, medium_url, hover_text} -> %>
      <a href={link} title={hover_text}><picture><img
        alt={hover_text}
        src={small_url}
        srcset={"#{small_url} 1x, #{medium_url} 2x"}
      /></picture></a>
    <% {:image, small_url, hover_text} -> %>
      <a href={link} title={hover_text}><picture><img alt={hover_text} src={small_url} /></picture></a>
    <% {:video, webm, mp4, hover_text} -> %>
      <a href={link} title={hover_text}><video
        alt={hover_text}
        autoplay="autoplay"
        disablepictureinpicture="disablepictureinpicture"
        loop="loop"
        muted="muted"
        playsinline="playsinline"
      ><source src={webm} type="video/webm" />
      <source src={mp4} type="video/mp4" /></video><img alt={hover_text} class="hidden" /></a>
    <% {:filtered_image, hover_text} -> %>
      <a href={link} title={hover_text}><picture><img alt={hover_text} /></picture></a>
    <% {:filtered_video, hover_text} -> %>
      <a href={link} title={hover_text}><video
        autoplay="autoplay"
        disablepictureinpicture="disablepictureinpicture"
        loop="loop"
        muted="muted"
        playsinline="playsinline"
      ></video><img alt={hover_text} /></a>
    <% :not_rendered -> %>
      <a href={link} phx-no-format>Thumbnails not yet generated </a>
  <% end %>
  <div class="media-box-overlays">
    <div :if={assigns[:notice] not in [nil, ""]}>{@notice}</div>
    <%= cond do %>
      <% @image.duplicate_id -> %>
        <div><strong>Marked Duplicate</strong></div>
      <% @image.destroyed_content -> %>
        <div><strong>Destroyed Content</strong></div>
      <% @image.hidden_from_users -> %>
        <div><strong>Deleted:</strong> {@image.deletion_reason}</div>
      <% true -> %>
    <% end %>
    <div class={["js-spoiler-info-overlay", !webm? && "hidden"]}>{if webm?, do: "WebM"}</div>
  </div>
</div>
