<div class="media-box scale-down" data-image-id={@image.id}>
  <div class="media-box-header actions">
    <a
      class="media-box-action fave js-interaction-fave"
      data-image-id={@image.id}
      href="#"
      rel="nofollow"
      title="Fave!"
    ><i class="fa fa-star"></i><span
      class="js-fave-count"
      data-image-id={@image.id}
      title="Favorites"
    >{@image.faves_count}</span></a>
    <a
      class="media-box-action upvote js-interaction-upvote"
      data-image-id={@image.id}
      href="#"
      rel="nofollow"
      title="Yay!"
    ><i class="fa fa-arrow-up"></i></a>
    <span class="media-box-score js-score" data-image-id={@image.id} title="Score">{@image.score}</span>
    <a
      class="media-box-action downvote js-interaction-downvote"
      data-image-id={@image.id}
      href="#"
      rel="nofollow"
      title="Neigh!"
    ><i class="fa fa-arrow-down"></i></a>
    <a class="media-box-action comments" href={"/#{@image.id}#comments"} title="Comments"><i class="fa fa-comments"></i><span data-image-id={
      @image.id
    }>{@image.comments_count}</span></a>
    <a
      class="media-box-action hide js-interaction-hide"
      data-image-id={@image.id}
      href="#"
      rel="nofollow"
      title="Hide"
    ><i class="fa fa-eye-slash"></i></a>
  </div>
  {render(PhilomenaWeb.ImageView, "_image_container.html",
    link: assigns[:link],
    image: @image,
    size: @size,
    class: "media-box-content",
    conn: @conn
  )}
</div>
