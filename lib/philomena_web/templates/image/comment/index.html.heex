<% route = fn p -> ~p"/images/#{@image}/comments?#{p}" end

pagination =
  render(PhilomenaWeb.PaginationView, "_pagination.html", page: @comments, route: route) %>
<div class="block">
  <div class="block-header">
    {pagination}
    <span class="block-header-title">{@image.comments_count} {pluralize(
      "comment",
      "comments",
      @image.comments_count
    )} posted</span>
    <button class="button" data-disable-with="..." id="js-refresh-comments" title="Refresh"><i class="fa fa-sync"></i>
    <span class="hidden-below-md">Refresh</span></button>
  </div>
</div>
<%= for {comment, body} <- @comments do %>
  {render(PhilomenaWeb.CommunicationView, "_communication.html",
    object: comment,
    body: body,
    conn: @conn
  )}
<% end %>
<div :if={multiple_pages?(@comments)} class="block">
  <div class="block-header sub">
    {pagination}
  </div>
</div>
