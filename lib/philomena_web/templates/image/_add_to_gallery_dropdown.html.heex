<div class="dropdown">
  <a
    aria-expanded="false"
    aria-haspopup="true"
    class="image-metabar-item"
    data-click-preventdefault="true"
    href="#"
    title="Galleries"
  ><i class="fa fa-images"></i><span class="hidden-below-xl">Galleries</span><i class="fa fa-caret-down"></i></a>
  <div class="dropdown-menu end add-to-gallery">
    <a class="dropdown-item" href={~p"/galleries?#{[gallery: [include_image: @image.id]]}"}>
      <i class="dropdown-icon fa fa-fw fa-table"></i>Featured in
    </a>
    <%= if Enum.any?(@user_galleries) do %>
      <hr class="dropdown-divider" />
      <div class="add-to-gallery-list">
        <div :for={{gallery, present} <- @user_galleries} id={"gallery_#{gallery.id}"}>
          <a
            class={["dropdown-item js-gallery-add", present && "hidden"]}
            data-fetchcomplete-hide={"#gallery_#{gallery.id} .js-gallery-add"}
            data-fetchcomplete-show={"#gallery_#{gallery.id} .js-gallery-remove"}
            data-method="post"
            data-remote="true"
            href={~p"/galleries/#{gallery}/images?#{[image_id: @image.id]}"}
          >{gallery.title}</a><a
            class={["dropdown-item active js-gallery-remove", !present && "hidden"]}
            data-fetchcomplete-hide={"#gallery_#{gallery.id} .js-gallery-remove"}
            data-fetchcomplete-show={"#gallery_#{gallery.id} .js-gallery-add"}
            data-method="delete"
            data-remote="true"
            href={~p"/galleries/#{gallery}/images?#{[image_id: @image.id]}"}
          >{gallery.title}</a>
        </div>
      </div>
    <% end %>
    <hr class="dropdown-divider" />
    <%= if @conn.assigns.current_user do %>
      <a class="dropdown-item" href={~p"/galleries/new?#{[with_image: @image.id]}"}>
        <i class="dropdown-icon fa fa-fw fa-plus"></i>Create a gallery
      </a>
    <% else %>
      <a class="dropdown-item" href={~p"/sessions/new"}>
        <i class="dropdown-icon fa fa-fw fa-user-plus"></i>Sign in to create a gallery
      </a>
    <% end %>
  </div>
</div>
