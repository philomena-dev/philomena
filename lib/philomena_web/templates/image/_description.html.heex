<div class="block">
  <div class="block-header">
    <span class="block-header-title"><i class="fas fa-file-lines"></i> Description</span>
    <a
      :if={@changeset && can?(@conn, :edit_description, @image)}
      accessKey="d"
      data-click-focus="#description"
      data-click-hide=".js-image-description"
      data-click-show="#description-form"
      href="#"
      id="edit-description"
      title="Edit description"
    ><i class="fas fa-edit"></i> Edit</a>
  </div>
  <div class="block-content markdown">
    <%= if String.length(@image.description) > 0 do %>
      {@body}
    <% else %>
      <em>No description provided.</em>
    <% end %>
  </div>
</div>
