<span class="image-uploader">{render(PhilomenaWeb.ImageView, "_uploader_name.html", assigns)}</span>
<%= if can?(@conn, :show, :identity_metadata) do %>
  <%= if @changeset do %>
    <%= form_for @changeset, ~p"/images/#{@image}/uploader", [class: "hidden", id: "uploader-form", data: [remote: "true", method: "put"]], fn f -> %>
      {label(f, :username, "Uploader")} {text_input(f, :username,
        value: username(@image.user),
        class: "input-field"
      )} {submit("Save Changes",
        class: "button button-size-badge",
        data: [disable_with: raw("Saving&hellip;")]
      )}
      <div>Changes IP to '127.0.0.1' and FP to 'ffff'. Empty for anonymous.</div>
    <% end %>
  <% end %>
  <div class="js-image-anonymous hidden">
    <%= if @image.anonymous do %>
      {button_to("Reveal author", ~p"/images/#{@image}/anonymous",
        class: "button button-size-badge",
        method: "delete",
        data: [confirm: "Are you really, really sure?"]
      )}
    <% else %>
      {button_to("Hide author", ~p"/images/#{@image}/anonymous",
        class: "button button-size-badge",
        method: "create",
        data: [confirm: "Are you really, really sure?"]
      )}
    <% end %>
  </div>
<% end %>
