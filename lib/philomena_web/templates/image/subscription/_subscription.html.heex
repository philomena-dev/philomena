<% subscription_path = ~p"/images/#{@image}/subscription" %>
<span :if={@conn.assigns.current_user} class="js-subscription-target"><a
  class={["image-metabar-item js-subscription-link", @watching && "hidden"]}
  data-method="post"
  data-remote="true"
  href={subscription_path}
><i class="fa fa-bell"></i>Subscribe</a><a
  class={["image-metabar-item js-subscription-link", !@watching && "hidden"]}
  data-method="delete"
  data-remote="true"
  href={subscription_path}
><i class="fa fa-bell-slash"></i>Unsubscribe</a></span><a
  :if={!@conn.assigns.current_user}
  class="image-metabar-item"
  href={~p"/sessions/new"}
><i class="fa fa-bell"></i>Subscribe</a>
