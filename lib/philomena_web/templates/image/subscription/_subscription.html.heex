<% watch_path = ~p"/images/#{@image}/subscription"
watch_class = if @watching, do: "hidden", else: ""

unwatch_path = ~p"/images/#{@image}/subscription"
unwatch_class = if @watching, do: "", else: "hidden" %><span
  :if={@conn.assigns.current_user}
  class="js-subscription-target"
><a
  class={"js-subscription-link #{watch_class}"}
  data-method="post"
  data-remote="true"
  href={watch_path}
  phx-no-format
><i class="fa fa-bell"></i> Subscribe </a><a
  class={"js-subscription-link #{unwatch_class}"}
  data-method="delete"
  data-remote="true"
  href={unwatch_path}
  phx-no-format
><i class="fa fa-bell-slash"></i> Unsubscribe </a></span><a
  :if={!@conn.assigns.current_user}
  href={~p"/sessions/new"}
  phx-no-format
><i class="fa fa-bell"></i> Subscribe </a>
