<div :if={multiple_pages?(@source_changes)} class="block-header">
  {@pagination}
</div>
<div class="block-content">
  <div class="table-wrap responsive">
    <table class="table striped">
      <thead>
        <tr>
          <th colspan="2">Image</th>
          <th>Source</th>
          <th>Action</th>
          <th>Timestamp</th>
          <th>User</th>
        </tr>
      </thead>
      <tbody>
        <%= for source_change <- @source_changes do %>
          <tr>
            <td>
              {link(source_change.image_id, to: ~p"/images/#{source_change.image}")}
            </td>
            <td>
              {render(PhilomenaWeb.ImageView, "_image_container.html",
                image: source_change.image,
                size: :thumb_tiny,
                conn: @conn
              )}
            </td>
            <td>{source_change.source_url}</td>
            <%= if source_change.added do %>
              <td class="table-success">Added</td>
            <% else %>
              <td class="table-danger">Removed</td>
            <% end %>
            <td>{pretty_time(source_change.created_at)}</td>
            <td class={user_column_class(source_change)}>
              {render(PhilomenaWeb.UserAttributionView, "_anon_user.html",
                object: source_change,
                conn: @conn
              )}
              <%= if can?(@conn, :show, :identity_metadata) do %>
                {link_to_ip(@conn, source_change.ip)} {link_to_fingerprint(
                  @conn,
                  source_change.fingerprint
                )}
              <% end %>
              <%= if staff?(source_change) do %>
                <br /><small><strong>Stop!</strong>
                This user is a staff member. <br />Ask them before reverting their changes.</small>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
<div :if={multiple_pages?(@source_changes)} class="block-header sub">
  {@pagination}
</div>
