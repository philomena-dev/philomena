<%= form_for @changeset, @action, [class: "content"], fn f -> %>
  {error_summary(@changeset)}
  <div class="form-control">
    {label(f, :name, "Name:")} {text_input(f, :name, class: "input-field full-width")}{error_tag(
      f,
      :name
    )}
  </div>
  <div class="form-control">
    {label(f, :short_name, "Slug:")} {text_input(f, :short_name, class: "input-field full-width")}{error_tag(
      f,
      :short_name
    )}
  </div>
  <div class="form-control">
    {label(f, :description, "Description:")} {textarea(f, :description,
      class: "input-field full-width"
    )}{error_tag(f, :description)}
  </div>
  <div class="form-control">
    {label(f, :access_level, "Access level:")} {select_field(
      f,
      :access_level,
      ["normal", "assistant", "staff"]
    )}{error_tag(f, :access_level)}
  </div>
  <div class="form-control-submit">{submit("Save Forum", class: "button")}</div>
<% end %>
