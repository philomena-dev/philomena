<%= form_for @changeset, @action, [multipart: true, class: "content"], fn f -> %>
  {error_summary(@changeset)}
  <%= if @changeset.data.__meta__.state != :loaded do %>
    <div class="form-control">
      {label(f, :image, "Upload image:")} {file_input(f, :image, class: "input-field full-width")}{error_tag(
        f,
        :image
      )}{error_tag(f, :image_mime_type)}{error_tag(f, :image_size)}{error_tag(f, :image_width)}{error_tag(
        f,
        :image_height
      )}
    </div>
  <% else %>
    <div class="form-control">
      {link("Change image", to: ~p"/admin/adverts/#{@changeset.data}/image/edit", class: "button")}
    </div>
  <% end %>
  <div class="form-control">
    {label(f, :link, "Link which the advert should take users to:")} {url_input(f, :link,
      class: "input-field full-width",
      placeholder: "Link",
      required: true
    )}{error_tag(f, :link)}
  </div>
  <div class="form-control">
    {label(f, :title, "Title/alt-text for the advert:")} {text_input(f, :title,
      class: "input-field full-width",
      placeholder: "Title",
      required: true
    )}{error_tag(f, :title)}
  </div>
  <div class="form-control">
    {label(f, :start_date, "Start time for the advert (usually \"now\"):")} {text_input(
      f,
      :start_date,
      class: "input-field full-width",
      placeholder: "Start"
    )}{error_tag(f, :start_date)}
  </div>
  <div class="form-control">
    {label(f, :finish_date, "Finish time for the advert (e.g. \"2 weeks from now\"):")} {text_input(
      f,
      :finish_date,
      class: "input-field full-width",
      placeholder: "Finish"
    )}{error_tag(f, :finish_date)}
  </div>
  <div class="form-control">
    {label(f, :notes, "Notes (Payment details, contact info, etc):")} {text_input(f, :notes,
      class: "input-field full-width",
      placeholder: "Notes"
    )}{error_tag(f, :notes)}
  </div>
  <div class="form-control">
    {label(f, :restrictions, "Restriction:")} {select_field(f, :restrictions, restrictions())}{error_tag(
      f,
      :restrictions
    )}
  </div>
  {checkbox_field(f, :live, "Live")}
  <div class="form-control-submit">{submit("Save Advert", class: "button")}</div>
<% end %>
