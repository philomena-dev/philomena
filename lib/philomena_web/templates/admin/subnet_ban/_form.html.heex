<%= form_for @changeset, @action, fn f -> %>
  <%= if @changeset.action do %>
    <div class="alert alert-danger">
      <p>Oops, something went wrong! Please check the errors below.</p>
    </div>
  <% end %>
  <div class="field">
    {label(f, :specification, "Specification:")} {text_input(f, :specification,
      class: "input-field",
      placeholder: "Specification",
      required: true
    )}{error_tag(f, :specification)}
  </div>
  <div class="field">
    {label(
      f,
      :reason,
      "Reason (shown to the banned user, and to staff on the user's profile page):"
    )} {text_input(f, :reason,
      class: "input-field full-width",
      placeholder: "Reason",
      required: true
    )}{error_tag(
      f,
      :reason
    )}
  </div>
  <div class="field">
    {label(f, :note, "Admin-only note:")} {text_input(f, :note,
      class: "input-field full-width",
      placeholder: "Note"
    )}
  </div>
  <div class="field">
    {label(
      f,
      :valid_until,
      "End time relative to now, in simple English (e.g. \"1 week from now\"):"
    )} {text_input(f, :valid_until,
      class: "input-field full-width",
      placeholder: "Until",
      required: true
    )}{error_tag(f, :valid_until)}
  </div>
  <br />
  {checkbox_field(f, :enabled, "Enabled")}
  <br />{submit("Save Ban", class: "button")}
<% end %>
