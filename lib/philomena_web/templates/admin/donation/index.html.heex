<% route = fn p -> ~p"/admin/donations?#{p}" end %>
<% pagination =
  render(PhilomenaWeb.PaginationView, "_pagination.html",
    page: @donations,
    route: route,
    conn: @conn
  ) %>
<h1>Donations</h1>
<div class="block">
  <div class="block-header">
    <div class="page__pagination">{pagination}</div>
  </div>
  <div class="block-content">
    {render(PhilomenaWeb.Admin.DonationView, "_table.html", donations: @donations, conn: @conn)}
  </div>
  <div class="block-header sub">
    <div class="page__pagination">{pagination}</div>
  </div>
</div>
