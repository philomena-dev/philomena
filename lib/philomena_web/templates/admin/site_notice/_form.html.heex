<%= form_for @changeset, @action, [class: "content"], fn f -> %>
  {error_summary(@changeset)}
  <div class="form-control">
    {label(f, :title, "Title (the bold bit) for the site notice; keep this short:")} {text_input(
      f,
      :title,
      class: "input-field full-width",
      placeholder: "Title",
      required: true
    )}{error_tag(
      f,
      :title
    )}
  </div>
  <div class="form-control">
    {label(f, :text, "Main body of the site notice:")} {text_input(f, :text,
      class: "input-field full-width",
      placeholder: "Text",
      required: true
    )}{error_tag(f, :text)}
  </div>
  <h3>Link <small>(optional; leave these two fields blank for no link)</small></h3>
  <div class="form-control">
    {label(f, :link_text, "Text which will contain the link:")} {text_input(f, :link_text,
      class: "input-field full-width",
      placeholder: "Link text"
    )}{error_tag(f, :link_text)}
  </div>
  <div class="form-control">
    {label(f, :link, "Link which the site notice should take users to:")} {text_input(f, :link,
      class: "input-field full-width",
      placeholder: "Link"
    )}{error_tag(f, :link)}
  </div>
  <h3>Run Time</h3>
  <div class="form-control">
    {label(f, :start_date, "Start time for the site notice (usually \"now\"):")} {text_input(
      f,
      :start_date,
      class: "input-field full-width",
      required: true
    )}{error_tag(f, :start_date)}
  </div>
  <div class="form-control">
    {label(f, :finish_date, "Finish time for the site notice (e.g. \"2 weeks from now\"):")} {text_input(
      f,
      :finish_date,
      class: "input-field full-width",
      required: true
    )}{error_tag(f, :finish_date)}
  </div>
  <h3>Enable</h3>
  {checkbox_field(f, :live, "Live")}
  <div class="form-control-submit">{submit("Save Site Notice", class: "button")}</div>
<% end %>
