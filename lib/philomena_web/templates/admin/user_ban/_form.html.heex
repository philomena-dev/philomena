<%= form_for @changeset, @action, [class: "content"], fn f -> %>
  {error_summary(@changeset)}
  {hidden_input(f, :user_id)}
  <div class="form-control">
    {label(
      f,
      :reason,
      "Reason (shown to the banned user, and to staff on the user's profile page):"
    )} {text_input(f, :reason,
      class: "input-field full-width",
      placeholder: "Reason",
      required: true
    )}{error_tag(
      f,
      :reason
    )}
  </div>
  <div class="form-control">
    {label(f, :note, "Admin-only note:")} {text_input(f, :note,
      class: "input-field full-width",
      placeholder: "Note"
    )}
  </div>
  <div class="form-control">
    {label(
      f,
      :valid_until,
      "End time relative to now, in simple English (e.g. \"1 week from now\"):"
    )} {text_input(f, :valid_until,
      class: "input-field full-width",
      placeholder: "Until",
      required: true
    )}{error_tag(f, :valid_until)}
  </div>
  <br />
  {checkbox_field(f, :enabled, "Enabled")}
  <div class="form-control-submit">{submit("Save Ban", class: "button")}</div>
<% end %>
