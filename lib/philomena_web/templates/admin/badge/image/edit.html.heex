<h2>Edit Badge</h2>
<%= form_for @changeset, ~p"/admin/badges/#{@badge}/image", [multipart: true, class: "content"], fn f -> %>
  {error_summary(@changeset)}
  <h4>Image</h4>
  <div class="form-control">
    {label(f, :image, "Upload SVG image:")} {file_input(f, :image,
      class: "input-field full-width"
    )}{error_tag(
      f,
      :image
    )}{error_tag(f, :image_mime_type)}
  </div>
  <div class="form-control-submit">
    {submit("Save Badge", class: "button", data: [disable_with: raw("Saving&hellip;")])}
  </div>
<% end %>
