<div class="block">
  <div :if={multiple_pages?(@users)} class="block-header">
    {@pagination}
  </div>
  <div class="block-content">
    <div class="table-wrap responsive">
      <table class="table striped hover">
        <thead>
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Activated</th>
            <th>Role</th>
            <th>Created</th>
            <th>Options</th>
          </tr>
        </thead>
        <tbody>
          <%= for user <- @users do %>
            <tr>
              <td phx-no-format>
              {link user.name, to: ~p"/profiles/#{user}"}<%= cond do %>
                <% user.otp_required_for_login -> %><span class="badge badge-success ms-md"><span><i class="fas fa-check"></i> 2FA</span></span> <% user.role != "user" -> %><span class="badge badge-danger ms-md"><span><i class="fas fa-times"></i> 2FA</span></span> <% true -> %><% end %>
            </td>
              <td>
                <%= if can?(@conn, :edit, Philomena.Users.User) do %>
                  {user.email}
                <% else %>
                  <i>N/A</i>
                <% end %>
              </td>
              <td>
                <%= cond do %>
                  <% user.deleted_at -> %>
                    <strong>Deactivated</strong> {pretty_time(user.deleted_at)}
                  <% user.confirmed_at -> %>
                    Active
                  <% true -> %>
                    <strong>Unconfirmed</strong>
                <% end %>
              </td>
              <td>{String.capitalize(user.role)}</td>
              <td>{pretty_time(user.created_at)}</td>
              <td>
                <%= if can?(@conn, :edit, user) do %>
                  <%= link to: ~p"/admin/users/#{user}/edit" do %>
                    <i class="fa fa-fw fa-user-edit"></i>Edit
                  <% end %>
                <% end %>
                <%!-- = if user.deleted_at do --%>
                <%!-- => link_to 'Reactivate', admin_user_activation_path(user), data: { confirm: t('are_you_sure') }, method: :create --%>
                <%!-- - else --%>
                <%!-- => link_to 'Deactivate', admin_user_activation_path(user), data: { confirm: t('are_you_sure') }, method: :delete --%>
                <%!-- ' &bull; --%>
                <%= if can?(@conn, :index, Philomena.Bans.User) do %>
                  <%= link to: ~p"/admin/user_bans/new?#{[user_id: user.id]}" do %>
                    <i class="fa fa-fw fa-ban"></i>Ban
                  <% end %>
                <% end %>
                <%= if can?(@conn, :create_links, user) do %>
                  <%= link to: ~p"/profiles/#{user}/artist_links/new" do %>
                    <i class="fa fa-fw fa-link"></i>Add link
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <div class="block-header sub">
    <div class="pagination-bar">
      {@pagination}{render(
        PhilomenaWeb.PaginationView,
        "_pagination_info.html",
        page: @users
      )}
    </div>
  </div>
</div>
