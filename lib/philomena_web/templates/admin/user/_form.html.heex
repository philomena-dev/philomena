<%= form_for @changeset, @action, [class: "content"], fn f -> %>
  <%= if @changeset.action do %>
    <div class="alert alert-danger">
      <p>Oops, something went wrong! Please check the errors below.</p>
    </div>
  <% end %>
  <div class="block">
    <div class="block-header">
      <span class="block-header-title">Essential user details</span>
    </div>
    <div class="block-content">
      <label class="table-list__label"><div class="table-list__label__text">Name:</div>
      <div class="table-list__label__input">
        {error_tag(f, :name)}{text_input(f, :name, class: "input-field")}
      </div></label><label class="table-list__label"><div class="table-list__label__text">
        Email:
      </div>
      <div class="table-list__label__input">
        {error_tag(f, :email)}{text_input(f, :email, class: "input-field")}
      </div></label><label class="table-list__label"><div class="table-list__label__text">
        Role:
      </div>
      <div class="table-list__label__input">
        {select_field(f, :role, ["user", "assistant", "moderator", "admin"])}
      </div></label><label class="table-list__label"><div class="table-list__label__text">
        Secondary banner:
      </div>
      <div class="table-list__label__input">
        {select_field(
          f,
          :secondary_role,
          [
            [key: "-", value: ""],
            "Site Developer",
            "Devops",
            "Philomena Contributor",
            "Public Relations"
          ]
        )}
      </div></label><label class="table-list__label"><div class="table-list__label__text">
        Hide staff banner:
      </div>
      <div class="table-list__label__input">
        {checkbox(f, :hide_default_role, class: "checkbox")}
      </div></label><label class="table-list__label"><div class="table-list__label__text">
        Senior staff:
      </div>
      <div class="table-list__label__input">{checkbox(f, :senior_staff, class: "checkbox")}</div></label><label class="table-list__label"><div class="table-list__label__text">
        Bypass rate limits:
      </div>
      <div class="table-list__label__input">
        {checkbox(f, :bypass_rate_limits, class: "checkbox")}
      </div></label>
      <div class="table-list__label">
        <div class="table-list__label__text">Avatar</div>
        <div class="table-list__label__input">
          {link("Remove avatar",
            to: ~p"/admin/users/#{@user}/avatar",
            class: "button",
            data: [method: "delete", confirm: "Are you really, really sure?"]
          )}
        </div>
      </div>
    </div>
  </div>
  <div class="block">
    <div class="block-header"><span class="block-header-title">General user flags</span></div>
    <div class="block-content">
      {error_tag(f, :roles)}
      <ul>
        {collection_checkboxes(f, :roles, filtered_roles(general_permissions(), @roles),
          mapper: &checkbox_mapper/6
        )}
      </ul>
    </div>
  </div>
  <div class="block block-warning">
    <div class="block-header">
      <span class="block-header-title">Special roles for assistants</span>
    </div>
    <div class="block-content">
      <ul>
        {collection_checkboxes(f, :roles, filtered_roles(assistant_permissions(), @roles),
          mapper: &checkbox_mapper/6
        )}
      </ul>
    </div>
  </div>
  <div class="block block-danger">
    <div class="block-header">
      <span class="block-header-title">Special roles for moderators</span>
    </div>
    <div class="block-content">
      <ul>
        {collection_checkboxes(f, :roles, filtered_roles(moderator_permissions(), @roles),
          mapper: &checkbox_mapper/6
        )}
      </ul>
    </div>
  </div>
  {submit("Save User", class: "button")}
<% end %>
