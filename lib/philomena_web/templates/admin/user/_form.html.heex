<%= form_for @changeset, @action, [class: "content"], fn f -> %>
  {error_summary(@changeset)}
  <div class="block">
    <div class="block-header">
      <span class="block-header-title">Essential user details</span>
    </div>
    <div class="block-content">
      <div class="form-control">
        {label(f, :name, "Name:")}{text_input(f, :name, class: "input-field")}{error_tag(f, :name)}
      </div>
      <div class="form-control">
        {label(f, :email, "Email:")}{text_input(f, :email, class: "input-field")}{error_tag(
          f,
          :email
        )}
      </div>
      <div class="form-control">
        {label(f, :role, "Role:")}{select_field(f, :role, [
          "user",
          "assistant",
          "moderator",
          "admin"
        ])}
      </div>
      <div class="form-control">
        {label(f, :secondary_role, "Secondary banner:")}{select_field(
          f,
          :secondary_role,
          [
            [key: "-", value: ""],
            "Site Developer",
            "Devops",
            "Philomena Contributor",
            "Public Relations"
          ]
        )}
      </div>
      {checkbox_field(f, :hide_default_role, "Hide staff banner")}
      {checkbox_field(f, :senior_staff, "Senior staff")}
      {checkbox_field(f, :bypass_rate_limits, "Bypass rate limits")}
      <div class="form-control">
        <span>Avatar:</span>
        {link("Remove avatar",
          to: ~p"/admin/users/#{@user}/avatar",
          class: "button",
          data: [method: "delete", confirm: "Are you really, really sure?"]
        )}
      </div>
    </div>
  </div>
  <div class="block">
    <div class="block-header"><span class="block-header-title">General user flags</span></div>
    <div class="block-content">
      {error_tag(f, :roles)}
      {collection_checkboxes(f, :roles, filtered_roles(general_permissions(), @roles),
        selected: role_ids(f.data)
      )}
    </div>
  </div>
  <div class="block block-warning">
    <div class="block-header">
      <span class="block-header-title">Special roles for assistants</span>
    </div>
    <div class="block-content">
      {collection_checkboxes(f, :roles, filtered_roles(assistant_permissions(), @roles),
        selected: role_ids(f.data)
      )}
    </div>
  </div>
  <div class="block block-danger">
    <div class="block-header">
      <span class="block-header-title">Special roles for moderators</span>
    </div>
    <div class="block-content">
      {collection_checkboxes(f, :roles, filtered_roles(moderator_permissions(), @roles),
        selected: role_ids(f.data)
      )}
    </div>
  </div>
  <div class="form-control-submit">{submit("Save User", class: "button")}</div>
<% end %>
