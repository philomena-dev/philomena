<h1>Users</h1>
<%= form_for @changeset, ~p"/admin/users", [as: :uq, method: "get", class: "hform"], fn f -> %>
  <div class="field">
    {text_input(f, :query,
      class: "hform__text input-field",
      placeholder: "Search query",
      spellcheck: "false"
    )} {submit("Search", class: "button hform__button")}
  </div>
  <div class="field">
    <% sort_fields = [
      "Sort by user ID": :id,
      "Sort by name": :name,
      "Sort by confirmation date": :confirmed_at,
      "Sort by last update date": :updated_at,
      "Sort by deactivation date": :deleted_at,
      "Sort by uploads": :images_count,
      "Sort by favorites": :image_faves_count,
      "Sort by comments": :comments_count,
      "Sort by votes": :image_votes_count,
      "Sort by metadata updates": :metadata_updates_count,
      "Sort by forum posts": :posts_count,
      "Sort by topics": :topics_count,
      "Sort by relevance": :_score
    ]

    sort_directions = [
      Descending: :desc,
      Ascending: :asc
    ] %>
    {select_field(f, :sf, sort_fields, autocomplete: "off")}{select_field(
      f,
      :sd,
      sort_directions,
      class: "ms-md",
      autocomplete: "off"
    )}
  </div>
  <div class="error">{error_tag(f, :query)}</div>
  <div class="error">{error_tag(f, :sf)}</div>
  <div class="error">{error_tag(f, :sd)}</div>
<% end %>
{link("Site staff", to: ~p"/admin/users?#{[uq: [query: "NOT role:user"]]}")} &bull; {link(
  "2FA users",
  to: ~p"/admin/users?#{[uq: [query: "otp_required_for_login:true"]]}"
)}
<h2>Search Results</h2>
<%= if not is_nil(@users) and Enum.any?(@users) do %>
  <% route = fn p -> ~p"/admin/users?#{p}" end %>
  <% pagination =
    render(PhilomenaWeb.PaginationView, "_pagination.html",
      page: @users,
      route: route,
      conn: @conn,
      params: scope(@conn)
    ) %>
  {render(PhilomenaWeb.Admin.UserView, "_list.html",
    users: @users,
    conn: @conn,
    pagination: pagination
  )}
<% else %>
  <p>No users found!</p>
<% end %>
<h3>Allowed fields</h3>
<table class="table">
