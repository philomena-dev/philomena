<%= form_for @changeset, @action, [class: "content"], fn f -> %>
  {error_summary(@changeset)}
  <div class="form-control">
    {label(f, :body, "Note")} {text_input(f, :body,
      class: "input-field full-width",
      required: true
    )}{error_tag(
      f,
      :body
    )}
  </div>
  {hidden_input(f, :user_id)}{hidden_input(f, :report_id)}{hidden_input(f, :dnp_entry_id)}
  <div class="form-control-submit">{submit("Save", class: "button")}</div>
<% end %>
