<div class="navbar-staff navbar-pinned js-staff-action">
  <% admin_links = admin_links(@conn) %>
  <div :if={admin_links != []} class="navbar-dropdown hidden-below-md">
    <button aria-haspopup="true" class="navbar-item caret" title="Admin" type="button">A</button>
    {render(PhilomenaWeb.LayoutView, "_navbar_menu.html",
      links: admin_links,
      label: "Admin",
      end: false
    )}
  </div>
  <a
    :if={@pending_approval_count}
    class="navbar-item"
    href={~p"/admin/approvals"}
    title="Approval Queue"
  >
    Q <span class="counter subtle">{@pending_approval_count}</span>
  </a>
  <a
    :if={@duplicate_report_count}
    class="navbar-item"
    href={~p"/duplicate_reports"}
    title="Duplicates"
  >
    D <span class="counter subtle">{@duplicate_report_count}</span>
  </a>
  <a :if={@report_count} class="navbar-item" href={~p"/admin/reports"} title="Reports">
    R <span class="counter subtle">{@report_count}</span>
  </a>
  <a
    :if={@artist_link_count}
    class="navbar-item"
    href={~p"/admin/artist_links"}
    title="Artist Links"
  >
    L <span class="counter subtle">{@artist_link_count}</span>
  </a>
  <a :if={@dnp_entry_count} class="navbar-item" href={~p"/admin/dnp_entries"} title="DNP Requests">
    S <span class="counter subtle">{@dnp_entry_count}</span>
  </a>
  <% ban_links = ban_links(@conn) %>
  <div :if={ban_links != []} class="navbar-dropdown hidden-below-md">
    <button aria-haspopup="true" class="navbar-item caret" title="Bans" type="button">B</button>
    {render(PhilomenaWeb.LayoutView, "_navbar_menu.html",
      links: ban_links,
      label: "Bans",
      end: true
    )}
  </div>
</div>
