<footer class="page-footer">
  <% footer_data = footer_data() %>
  <div class="page-footer-columns">
    <div :for={column <- footer_data["cols"]} class="page-footer-column">
      <h5>{column}</h5>
      <%= for row <- footer_data[column] do %>
        <%= if row["bold"] do %>
          <strong><a href={row["url"]} target={row["target"] || "_self"}>{row["title"]}</a></strong>
        <% else %>
          <a href={row["url"]} target={row["target"] || "_self"}>{row["title"]}</a>
        <% end %>
      <% end %>
    </div>
  </div>
  <div class="page-footer-info" phx-no-format>
    Powered by <a href="https://github.com/philomena-dev/philomena">philomena</a> <br />
    <%= if hide_version() do %>(<% else %>(version {philomena_version()}, <% end %>page generated in {render_time(@conn)}ms)
  </div>
</footer>
