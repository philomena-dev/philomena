<nav class="navbar secondary" aria-label="Sections">
  <%= for section <- site_sections(@conn) do %>
    <%= if section.pages == [] do %>
      <a class="navbar-item" href={section.path}>
        {section.label}<span :if={section[:count]} class="counter subtle">{section.count}</span>
      </a>
    <% else %>
      <div class="navbar-dropdown">
        <a aria-haspopup="true" class="navbar-item caret" href={section.path}>{section.label}</a>
        {render(PhilomenaWeb.LayoutView, "_navbar_menu.html",
          links: section.pages,
          label: section.label,
          end: false
        )}
      </div>
    <% end %>
  <% end %>
  <%= if staff?(@conn) do %>
    {render(PhilomenaWeb.LayoutView, "_header_staff_links.html", assigns)}
  <% end %>
</nav>
