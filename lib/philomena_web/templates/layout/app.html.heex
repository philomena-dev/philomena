<!DOCTYPE html>
<html lang="en">
  <head>
    <meta content="IE=edge" http-equiv="X-UA-Compatible" />
    {viewport_meta_tag(@conn)}
    <title phx-no-format><%= if assigns[:title] do %>{assigns[:title]} - Derpibooru <% else %>Derpibooru <% end %></title>
    <link href={"https://#{cdn_host()}"} rel="preconnect" />
    <link href={~p"/css/application.css"} rel="stylesheet" />
    <link href={stylesheet_path(@conn, @current_user)} id="js-theme-stylesheet" rel="stylesheet" />
    <%= if is_nil(@current_user) do %>
      <link href={light_stylesheet_path(@conn)} id="js-theme-stylesheet" media="(prefers-color-scheme: light)" rel="stylesheet" />
    <% end %>
    {render PhilomenaWeb.LayoutView, "_options.html", assigns}
    <link href="/favicon.ico" rel="icon" type="image/x-icon" />
    <link href="/favicon.svg" rel="icon" type="image/svg+xml" />
    <link href="/opensearch.xml" rel="search" title="Derpibooru" type="application/opensearchdescription+xml" />
    {csrf_meta_tag()}
    <%= if vite_hmr?() do %>
      <script src={vite_asset_url(@conn, "/@vite/client")} type="module"></script>
      <script src={vite_asset_url(@conn, "/js/app.ts")} type="module"></script>
    <% else %>
      <script async="async" src={~p"/js/app.js"} type="text/javascript"></script>
    <% end %>
    {render PhilomenaWeb.LayoutView, "_opengraph.html", assigns}
  </head>
  <body data-hide-staff-tools={hide_staff_tools_attribute(@conn)} data-theme={theme_name(@current_user)} data-vite-reload={to_string(vite_hmr?())}>
    {render PhilomenaWeb.LayoutView, "_burger.html", assigns}
    <div class={"#{container_class(@current_user)}"} id="container">
      {render PhilomenaWeb.LayoutView, "_header.html", assigns}{render PhilomenaWeb.LayoutView, "_flash_warnings.html", assigns}
      <main class={"#{layout_class(@conn)}"} id="content">{@inner_content}</main>
      {render PhilomenaWeb.LayoutView, "_footer.html", assigns}
      <form class="hidden"><input class="js-interaction-cache" type="hidden" value="{}" /></form>
      {clientside_data(@conn)}
    </div>
  </body>
</html>
