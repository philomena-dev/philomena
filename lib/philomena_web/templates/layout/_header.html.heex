<header class="header borderless">
  <nav class="navbar" aria-label="Site">
    <button
      aria-controls="burger"
      aria-expanded="false"
      class="navbar-item navbar-burger js-burger-toggle"
      title="Menu"
      type="button"
    >
      <i class="navbar-icon fa fa-fw fa-bars"></i>
    </button>
    <a class="navbar-item navbar-pinned" href="/" title="Derpibooru">
      <i class="navbar-icon fa-fw favicon-home"></i>
      <span class="hidden-below-xl">Derpibooru</span>
    </a>
    <a class="navbar-item" href="/images/new" title="Upload">
      <i class="navbar-icon fa fa-upload"></i>
    </a>
  </nav>
  <%= form_for @conn, ~p"/search", [method: "get", class: "header-field header-search", enforce_utf8: false], fn f -> %>
    <% title =
      "For terms all required, separate with ',' or 'AND'; also supports 'OR' " <>
        "for optional terms and '-' or 'NOT' for negation. Search with a blank " <>
        "query for more options or click the ? for syntax help" %>
    <input
      aria-label="Search"
      autocapitalize="none"
      autocomplete={if(@conn.cookies["enable_search_ac"], do: "on", else: "off")}
      class="header-field-input"
      data-autocomplete="multi-tags"
      data-autocomplete-condition="enable_search_ac"
      data-autocomplete-history-id="search-history"
      id="q"
      inputmode="search"
      name="q"
      placeholder="Search"
      spellcheck="false"
      title={title}
      value={input_value(f, :q)}
    />
    <input
      :for={field <- [:sf, :sd, :hidden]}
      :if={present?(input_value(f, field))}
      name={field}
      type="hidden"
      value={input_value(f, field)}
    />
    <%= if hides_images?(@conn) do %>
      {select(f, :del, [{"-D", ""}, {"+D", 1}, {"*D", "deleted"}, {"DO", "only"}],
        name: "del",
        class: "header-field-input js-staff-action",
        autocomplete: "off",
        "aria-label": "Deleted images"
      )}
    <% end %>
    <button class="header-field-button" title="Search" type="submit"><i class="fas fa-fw fa-search"></i></button>
    <a class="header-field-button" href="/search/reverse" title="Search using an image">
      <i class="fas fa-fw fa-camera"></i>
    </a>
    <a class="header-field-button" href="/pages/search_syntax" title="Search syntax help">
      <i class="fas fa-fw fa-question"></i>
    </a>
  <% end %>
  <div class="navbar">
    <%= if @current_user do %>
      <a class="navbar-item navbar-pinned" href="/notifications" title="Notifications">
        <i class="navbar-icon fas fa-bell"></i>
        <span
          class="counter subtle js-notification-ticker"
          data-notification-count={@notification_count}
        >
          {@notification_count}
        </span>
      </a>
      <a class="navbar-item navbar-pinned" href="/conversations" title="Conversations">
        <%= if @conversation_count > 0 do %>
          <i class="navbar-icon unread fas fa-envelope-open"></i>
          <span class="counter subtle">{@conversation_count}</span>
        <% else %>
          <i class="navbar-icon fas fa-envelope"></i>
        <% end %>
      </a>
      <a class="navbar-item" href="/filters" title="Filters">
        <i class="navbar-icon fa fa-filter"></i>
        <span class="hidden-below-xl">Filters</span>
      </a>
      <%= form_for @user_changeset, ~p"/filters/current", [class: "header-field", id: "filter-quick-form"], fn f -> %>
        {select(f, :current_filter_id, @available_filters,
          name: "id",
          id: "filter-quick-menu",
          class: "header-field-input",
          data: [change_submit: "#filter-quick-form"],
          autocomplete: "off",
          "aria-label": "Filter"
        )}
      <% end %>
      <%= form_for @spoiler_changeset, ~p"/filters/spoiler_type", [class: "header-field hidden-below-xl", id: "spoiler-quick-form"], fn f -> %>
        {select(f, :spoiler_type, @spoiler_types,
          id: "spoiler-quick-menu",
          class: "header-field-input",
          data: [change_submit: "#spoiler-quick-form"],
          autocomplete: "off",
          "aria-label": "Spoilers"
        )}
      <% end %>
      <div class="navbar-dropdown navbar-pinned">
        <a
          aria-expanded="false"
          aria-haspopup="true"
          class="navbar-item caret"
          href={~p"/profiles/#{@current_user}"}
          title="Profile"
        >
          {render(PhilomenaWeb.UserAttributionView, "_user_avatar.html",
            object: %{user: @current_user},
            class: "avatar-xs",
            no_profile_link: true
          )}
        </a>
        {render(PhilomenaWeb.LayoutView, "_navbar_menu.html",
          links: user_links(@current_user),
          align_end: true
        )}
      </div>
    <% else %>
      <a class="navbar-item" href="/filters">Filters ({@current_filter.name})</a>
      <a class="navbar-item" href="/settings/edit">Settings</a>
      <a class="navbar-item navbar-pinned" href={~p"/registrations/new"}>Register</a>
      <a class="navbar-item navbar-pinned" href={~p"/sessions/new"}>Login</a>
    <% end %>
  </div>
</header>
{render(PhilomenaWeb.LayoutView, "_header_navigation.html", assigns)}
