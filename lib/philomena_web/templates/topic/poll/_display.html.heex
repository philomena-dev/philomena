<div class="block">
  <div class="tabs">
    {link("Voting", to: "#", class: "tab selected", data: [click_tab: "voting"])}
    <%= if can?(@conn, :hide, @topic) do %>
      {link("Voters",
        to: "#",
        class: "tab",
        data: [click_tab: "voters", load_tab: ~p"/forums/#{@forum}/topics/#{@topic}/poll/votes"]
      )}{link("Administrate", to: "#", class: "tab", data: [click_tab: "administration"])}
    <% end %>
  </div>
  <div class="tab-panel selected" data-tab="voting">
    <div class="poll">
      <div class="poll-area">
        <%= if @poll_active and not @voted and not is_nil(@conn.assigns.current_user) do %>
          {render(PhilomenaWeb.Topic.PollView, "_vote_form.html", assigns)}
        <% else %>
          {render(PhilomenaWeb.Topic.PollView, "_results.html", assigns)}
        <% end %>
      </div>
    </div>
  </div>
  <%= if can?(@conn, :hide, @topic) do %>
    <div class="tab-panel" data-tab="voters">
      <p>Loading&hellip;</p>
    </div>
    <div class="tab-panel" data-tab="administration">
      <a
        class="button button-warning js-staff-action"
        href={~p"/forums/#{@forum}/topics/#{@topic}/poll/edit"}
      ><i class="fa fa-edit"></i> Edit</a>
    </div>
  <% end %>
</div>
