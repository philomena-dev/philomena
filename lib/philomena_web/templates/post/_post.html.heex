<% staff? = can?(@conn, :hide, @post) %>
<article
  class={["communication allow-overflow", @post.hidden_from_users && "deleted"]}
  id={"post_#{@post.id}"}
>
  <div :if={not @post.approved and not @post.hidden_from_users} class="communication-notice">
    <span><i class="fas fa-exclamation-triangle"></i>
    This post is pending approval from a staff member.</span>
    <%= if can?(@conn, :approve, @post) do %>
      <div class="button-group separated button-size-badge">
        <%= link(to: ~p"/forums/#{@post.topic.forum}/topics/#{@post.topic}/posts/#{@post}/approve", data: [confirm: "Are you sure?"], method: "post", class: "button") do %>
          <i class="fas fa-check"></i> Approve
        <% end %>
        <a
          class="button togglable-delete-form-link"
          data-click-toggle={"#inline-reject-form-post-#{@post.id}"}
          href="#"
        ><i class="fa fa-times"></i> Reject</a>
      </div>
      <%= form_for :post, ~p"/forums/#{@post.topic.forum}/topics/#{@post.topic}/posts/#{@post}/hide", [class: "togglable-delete-form hidden flex", id: "inline-reject-form-post-#{@post.id}"], fn f -> %>
        {text_input(f, :deletion_reason,
          class: "input-field full-width",
          placeholder: "Deletion Reason",
          id: "inline-reject-reason-post-#{@post.id}",
          required: true
        )}{submit("Delete", class: "button")}
      <% end %>
    <% end %>
  </div>
  <div :if={@post.hidden_from_users} class="communication-notice">
    <span>Deletion reason: {@post.deletion_reason}</span>
    <span :if={staff? and @post.destroyed_content}>This post's contents have been destroyed.</span>
    <span :if={staff? and not is_nil(@post.deleted_by)} class="communication-notice-by">
      {@post.deleted_by.name}
    </span>
  </div>
  {render(PhilomenaWeb.CommunicationView, "_body.html",
    object: @post,
    text: if(not @post.hidden_from_users or (staff? and not @post.destroyed_content), do: @body),
    conn: @conn
  )}
  {render(PhilomenaWeb.PostView, "_post_options.html", conn: @conn, post: @post)}
</article>
