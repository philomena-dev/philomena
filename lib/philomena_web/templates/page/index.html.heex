<h1>Pages</h1>
<div class="table-wrap responsive">
  <table class="table striped">
    <thead>
      <tr>
        <th>Title</th>
      </tr>
    </thead>
    <tbody>
      <%= for static_page <- @static_pages do %>
        <tr>
          <td>{link(static_page.title, to: ~p"/pages/#{static_page}")}</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<br />{link("New static page", to: ~p"/pages/new")}
