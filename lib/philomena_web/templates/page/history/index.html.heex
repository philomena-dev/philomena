<h1>Revision history for {link(@static_page.title, to: ~p"/pages/#{@static_page}")}</h1>
<div class="table-wrap responsive">
  <table class="table">
    <thead>
      <tr>
        <th>User</th>
        <th>Date</th>
        <th>Body</th>
      </tr>
    </thead>
    <tbody>
      <%= for version <- @versions do %>
        <tr>
          <td>{link(version.user.name, to: ~p"/profiles/#{version.user}")}</td>
          <td>{pretty_time(version.created_at)}</td>
          <td>{version.difference}</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
