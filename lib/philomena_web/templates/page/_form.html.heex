<%= form_for @changeset, @action, [class: "content"], fn f -> %>
  {error_summary(@changeset)}
  <div class="form-control">
    {label(f, :title)} {text_input(f, :title, class: "input-field full-width")}
  </div>
  <div class="form-control">
    {label(f, :slug)} {text_input(f, :slug, class: "input-field full-width")}
  </div>
  <div class="form-control">
    {label(f, :body)} {textarea(f, :body, class: "input-field full-width")}
  </div>
  <div class="form-control-submit">{submit("Save", class: "button")}</div>
<% end %>
