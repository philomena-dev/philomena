<%= form_for @changeset, @action, fn f -> %>
  <%= if @changeset.action do %>
    <div class="alert alert-danger">
      <p>Oops, something went wrong! Please check the errors below.</p>
    </div>
  <% end %>
  <div class="field">
    {label(f, :title)} {text_input(f, :title, class: "input-field full-width")}
  </div>
  <div class="field">
    {label(f, :slug)} {text_input(f, :slug, class: "input-field full-width")}
  </div>
  <div class="field">{label(f, :body)} {textarea(f, :body, class: "input-field full-width")}</div>
  <div class="actions">{submit("Save", class: "button")}</div>
<% end %>
