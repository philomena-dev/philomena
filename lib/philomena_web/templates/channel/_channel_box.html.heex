<% channel_path = ~p"/channels/#{@channel}" %>
<div class="media-box landscape">
  <div class="media-box-header">
    <a href={channel_path} title={@channel.title}>{@channel.title || @channel.short_name}</a>
  </div>
  <div class="media-box-header">
    <%= if @channel.is_live do %>
      <span class="badge badge-success"><strong>LIVE NOW</strong></span>
      <span>{@channel.viewers} {pluralize("viewer", "viewers", @channel.viewers)}</span>
    <% else %>
      <span class="badge badge-danger"><strong>OFF AIR</strong></span>
    <% end %>
  </div>
  <a class="media-box-content" href={channel_path}>
    <img alt={"#{@channel.title}"} src={channel_image(@channel)} />
    <span :if={@channel.nsfw} class="media-box-overlay">NSFW</span>
  </a>
  <div class="media-box-header">
    <%= if @channel.associated_artist_tag do %>
      <a href={~p"/tags/#{@channel.associated_artist_tag}"}><i class="fa fa-fw fa-tags"></i> {@channel.associated_artist_tag.name}</a>
    <% else %>
      <span>No artist tag</span>
    <% end %>
  </div>
  <%= if can?(@conn, :edit, @channel) do %>
    <div class="media-box-header">
      <a href={~p"/channels/#{@channel}/edit"}><i class="fas fa-fw fa-edit"></i> Edit</a>
    </div>
    <div class="media-box-header">
      <a data-confirm="Are you really, really sure?" data-method="delete" href={channel_path}><i class="fas fa-fw fa-trash"></i>
      Delete</a>
    </div>
  <% end %>
  <div class="media-box-header">
    {render(PhilomenaWeb.SubscriptionView, "_subscription.html",
      conn: @conn,
      watching: @subscriptions[@channel.id],
      target: @channel
    )}
  </div>
</div>
