<%= form_for @changeset, @action, [class: "content"], fn f -> %>
  {error_summary(@changeset)}
  <div class="form-control">
    <div class="form-message form-message-description">
      The short name of
      <code class="code-span">https://picarto.tv/<em>picarto_channel_name</em></code>
      is <code class="code-span">picarto_channel_name</code>.
    </div>
    <div class="form-message form-message-description">
      The short name of
      <code class="code-span">https://piczel.tv/watch/<em>piczel_channel_name</em></code>
      is <code class="code-span">piczel_channel_name</code>.
    </div>
    {label(f, :short_name, "Short name")} {text_input(f, :short_name,
      class: "input-field",
      placeholder: "Short name",
      required: true
    )}
  </div>
  <div class="form-control">
    {label(f, :type, "Type")} {select_field(f, :type, ["PicartoChannel", "PiczelChannel"])}
  </div>
  <div class="form-control">
    {label(f, :artist_tag, "Artist tag")} {text_input(f, :artist_tag,
      class: "input-field",
      placeholder: "Artist tag",
      spellcheck: "false"
    )}
  </div>
  <div class="form-control-submit">{submit("Save", class: "button")}</div>
<% end %>
