<% subscription_path = ~p"/channels/#{@channel}/subscription" %>
<span :if={@conn.assigns.current_user} class="js-subscription-target"><a
  class={["js-subscription-link", @watching && "hidden"]}
  data-method="post"
  data-remote="true"
  href={subscription_path}
  phx-no-format
><i class="fa fa-bell"></i> <span class="hidden-below-md">Subscribe</span> </a><a
  class={["js-subscription-link", !@watching && "hidden"]}
  data-method="delete"
  data-remote="true"
  href={subscription_path}
  phx-no-format
><i class="fa fa-bell-slash"></i> <span class="hidden-below-md">Unsubscribe</span> </a></span><a
  :if={!@conn.assigns.current_user}
  href={~p"/sessions/new"}
  phx-no-format
><i class="fa fa-bell"></i> <span class="hidden-below-md">Subscribe</span> </a>
