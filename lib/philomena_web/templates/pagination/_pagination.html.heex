<nav :if={multiple_pages?(@page)} class="pagination" aria-label="Pages" phx-no-format>
  <%= if first_page?(@page) do %>
    <span class="pagination-link"><span class="pagination-icon"><i class="fa fa-backward-fast"></i></span>First</span>
    <span class="pagination-link"><span class="pagination-icon"><i class="fa fa-chevron-left"></i></span>Prev</span>
  <% else %>
    <a class="pagination-link" href={first_page_path(@page, @route, @params)}><span class="pagination-icon"><i class="fa fa-backward-fast"></i></span>First</a>
    <a class="pagination-link js-prev" href={prev_page_path(@page, @route, @params)}><span class="pagination-icon"><i class="fa fa-chevron-left"></i></span>Prev</a>
  <% end %>
  <span :if={left_gap?(@page)} class="pagination-gap hidden-below-md">…</span>
  <a :for={number <- left_page_numbers(@page)} class="pagination-link hidden-below-md" href={page_path(@route, @params, number)}>{number}</a>
  <span class="pagination-link current" aria-current="page">{@page.page_number}</span>
  <a :for={number <- right_page_numbers(@page)} class="pagination-link hidden-below-md" href={page_path(@route, @params, number)}>{number}</a>
  <span :if={right_gap?(@page)} class="pagination-gap hidden-below-md">…</span>
  <%= if last_page?(@page) do %>
    <span class="pagination-link">Next<span class="pagination-icon"><i class="fa fa-chevron-right"></i></span></span>
    <span class="pagination-link">Last<span class="pagination-icon"><i class="fa fa-forward-fast"></i></span></span>
  <% else %>
    <a class="pagination-link js-next" href={next_page_path(@page, @route, @params)}>Next<span class="pagination-icon"><i class="fa fa-chevron-right"></i></span></a>
    <a class="pagination-link" href={last_page_path(@page, @route, @params)}>Last<span class="pagination-icon"><i class="fa fa-forward-fast"></i></span></a>
  <% end %>
</nav>
