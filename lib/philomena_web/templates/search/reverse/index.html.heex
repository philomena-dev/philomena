<h1>Reverse Search</h1>
<%= form_for @changeset, ~p"/search/reverse", [multipart: true, as: :image, class: "content"], fn f -> %>
  <div class="walloftext">
    <p>
      Basic image similarity search. Finds uploaded images similar to the one provided based on simple intensities and uses the median frame of animations; very low contrast images (such as sketches) will produce poor results and, regardless of contrast, results may include seemingly random images that look very different.
    </p>
  </div>
  <div class="image-other">
    <div id="js-image-upload-previews"></div>
    <p>
      Upload a file from your computer, or provide a link to the page containing the image and click Fetch.
    </p>
    <div class="form-control">
      {file_input(f, :image, class: "input-field js-scraper")}{error_tag(f, :uploaded_image)}{error_tag(
        f,
        :image_width
      )}{error_tag(f, :image_height)}{error_tag(f, :image_mime_type)}
    </div>
    <div class="form-input-group">
      {url_input(f, :url,
        name: "url",
        class: "input-field js-scraper",
        placeholder: "Link a deviantART page, a Tumblr post, or the image directly"
      )}<button
        class="button"
        data-disable-with="Fetch"
        disabled
        id="js-scraper-preview"
        title="Fetch the image at the specified URL"
        type="button"
      >Fetch</button>
    </div>
    <div class="alert alert-warning hidden js-scraper"></div>
  </div>
  <h4>Optional settings</h4>
  <div class="form-control">
    {label(f, :distance, "Match distance (suggested values: between 0.2 and 0.5)")}{number_input(
      f,
      :distance,
      min: 0,
      max: 1,
      step: 0.01,
      class: "input-field"
    )}{error_tag(f, :distance)}
  </div>
  {error_tag(f, :limit)}
  <div class="form-control-submit">{submit("Reverse Search", class: "button")}</div>
<% end %>
<%= cond do %>
  <% is_nil(@images) -> %>
    <%!-- Don't render anything. --%>
  <% Enum.any?(@images) -> %>
    <div class="block" id="imagelist-container">
      <section class="block-header">
        <span class="block-header-title">Search by uploaded image</span>
      </section>
      <div class="block-content media-list">
        <%= for image <- @images do %>
          {render(PhilomenaWeb.ImageView, "_image_box.html",
            image: image,
            link: ~p"/images/#{image}",
            size: :thumb,
            conn: @conn
          )}
        <% end %>
      </div>
      <div class="block-header sub">
        {render(PhilomenaWeb.PaginationView, "_pagination_info.html", page: @images)}
        <div class="block-header-actions">
          <a href="/settings/edit" title="Display Settings"><i class="fa fa-cog"></i>
          <span class="hidden-below-xl">Display Settings</span></a>
        </div>
      </div>
    </div>
  <% true -> %>
    <p>No images found!</p>
<% end %>
