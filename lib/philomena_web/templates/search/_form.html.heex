<h1>Search</h1>
<%= form_for @conn, ~p"/search", [id: "searchform", method: "get", class: "js-search-form", enforce_utf8: false], fn f -> %>
  {text_input(f, :q,
    class: "input-field full-width js-search-field",
    placeholder: "Search terms are chained with commas",
    autocapitalize: "none",
    autocomplete: if(@conn.cookies["enable_search_ac"], do: "on", else: "off"),
    inputmode: "search",
    data: [
      autocomplete: "multi-tags",
      autocomplete_condition: "enable_search_ac",
      autocomplete_history_id: "search-history"
    ],
    spellcheck: "false"
  )}
  <div class="block allow-overflow">
    <div class="block-header">
      <button class="link-button" data-search-prepend="-" type="button">NOT</button>
      <div class="dropdown">
        <a aria-expanded="false" aria-haspopup="true" data-click-preventdefault="true" href="#">Search terms
        <i class="fa fa-caret-down"></i></a>
        <div class="dropdown-menu">
          <button
            class="dropdown-item"
            data-search-add="score.gte:100"
            data-search-select-last="3"
            data-search-show-help="numeric"
            type="button"
          >Score</button><button
            class="dropdown-item"
            data-search-add="created_at.lte:3 years ago"
            data-search-select-last="11"
            data-search-show-help="date"
            type="button"
          >Created at</button><button
            class="dropdown-item"
            data-search-add="id.lte:10"
            data-search-select-last="2"
            data-search-show-help="numeric"
            type="button"
          >Numeric ID</button><button
            class="dropdown-item"
            data-search-add="faves.gte:100"
            data-search-select-last="3"
            data-search-show-help="numeric"
            type="button"
          >Number of faves</button><button
            class="dropdown-item"
            data-search-add="upvotes.gte:100"
            data-search-select-last="3"
            data-search-show-help="numeric"
            type="button"
          >Number of upvotes</button><button
            class="dropdown-item"
            data-search-add="downvotes.gte:100"
            data-search-select-last="3"
            data-search-show-help="numeric"
            type="button"
          >Number of downvotes</button><button
            class="dropdown-item"
            data-search-add="comment_count.gt:20"
            data-search-select-last="2"
            data-search-show-help="numeric"
            type="button"
          >Number of comments</button><button
            class="dropdown-item"
            data-search-add="uploader:k_a"
            data-search-select-last="3"
            data-search-show-help="literal"
            type="button"
          >Uploader</button><button
            class="dropdown-item"
            data-search-add="original_format:gif"
            data-search-select-last="3"
            data-search-show-help="literal"
            type="button"
          >File extension</button><button
            class="dropdown-item"
            data-search-add="file_name:tumblr_*"
            data-search-select-last="8"
            data-search-show-help="literal"
            type="button"
          >Original file name</button><button
            class="dropdown-item"
            data-search-add="mime_type:image/jpeg"
            data-search-select-last="10"
            data-search-show-help="literal"
            type="button"
          >MIME type</button><button
            class="dropdown-item"
            data-search-add="source_url:*deviantart.com*"
            data-search-select-last="16"
            data-search-show-help="literal"
            type="button"
          >Image source URL</button><button
            class="dropdown-item"
            data-search-add="width:1920"
            data-search-select-last="4"
            data-search-show-help="numeric"
            type="button"
          >Image width</button><button
            class="dropdown-item"
            data-search-add="height:1080"
            data-search-select-last="4"
            data-search-show-help="numeric"
            type="button"
          >Image height</button><button
            class="dropdown-item"
            data-search-add="aspect_ratio:1"
            data-search-select-last="1"
            data-search-show-help="numeric"
            type="button"
          >Aspect ratio</button><button
            class="dropdown-item"
            data-search-add="animated:false"
            data-search-select-last="5"
            data-search-show-help="boolean"
            type="button"
          >Animated</button><button
            class="dropdown-item"
            data-search-add="duration:10"
            data-search-select-last="2"
            data-search-show-help="numeric"
            type="button"
          >Duration (seconds)</button><button
            class="dropdown-item"
            data-search-add="pixels.gte:5000000"
            data-search-select-last="7"
            data-search-show-help="numeric"
            type="button"
          >Pixels</button><button
            class="dropdown-item"
            data-search-add="size.lt:1048576"
            data-search-select-last="7"
            data-search-show-help="numeric"
            type="button"
          >File size (bytes)</button>
        </div>
      </div>
      <%= if @conn.assigns.current_user do %>
        <div class="dropdown">
          <a aria-expanded="false" aria-haspopup="true" data-click-preventdefault="true" href="#">Belonging to&hellip;
          <i class="fa fa-caret-down"></i></a>
          <div class="dropdown-menu">
            <button
              class="dropdown-item"
              data-search-add="my:faves"
              data-search-show-help=" "
              type="button"
            >My favorites</button><button
              class="dropdown-item"
              data-search-add="my:upvotes"
              data-search-show-help=" "
              type="button"
            >My upvotes</button><button
              class="dropdown-item"
              data-search-add="my:uploads"
              data-search-show-help=" "
              type="button"
            >My uploads</button><button
              class="dropdown-item"
              data-search-add="my:watched"
              data-search-show-help=" "
              type="button"
            >My watched tags</button>
          </div>
        </div>
      <% end %>
      <div class="block-header-actions">
        <a data-click-toggle="#js-search-tags" href="#">Quick tags</a><a href="/pages/search_syntax">Help</a>
      </div>
    </div>
    <div class="block-content">
      <div class="hidden walloftext" data-search-help="boolean">
        <strong class="js-search-help-subject"></strong>
        is a Boolean-valued field. It only accepts the values <code class="code-span">true</code>
        and <code class="code-span">false</code>.<br /><br /> <em>Example:</em>
        to find images which are not animated, you would use <code class="code-span">animated:false</code>.
      </div>
      <div class="hidden walloftext" data-search-help="numeric">
        <strong class="js-search-help-subject"></strong>
        is a numerical range field. Four qualifiers, <code class="code-span">gte</code>
        (greater than or equal), <code class="code-span">lte</code>
        (less than or equal), <code class="code-span">gt</code>
        (greater than), and <code class="code-span">lt</code>
        (less than), can be applied to the desired value.<br /><br /> <em>Example:</em>
        to find images with a score greater than 100, you would use
        <code class="code-span">score.gt:100</code>
        .
      </div>
      <div class="hidden walloftext" data-search-help="date">
        <strong class="js-search-help-subject"></strong>
        is a date/time field. It accepts a <a href="/pages/search_syntax#date-range">tweaked subset of the ISO 8601 standard</a>, as well as relative dates <code class="code-span">(X minutes/hours/days/months/years ago)</code>. Four qualifiers,
        <code class="code-span">gte</code>
        (greater than or equal), <code class="code-span">lte</code>
        (less than or equal), <code class="code-span">gt</code>
        (greater than), and <code class="code-span">lt</code>
        (less than), can be applied to the desired value.<br /><br /> <em>Example:</em>
        to find images created before 2013, you would use
        <code class="code-span">created_at.lt:2013</code>
        .
      </div>
      <div class="hidden walloftext" data-search-help="literal">
        <strong class="js-search-help-subject"></strong>
        is a literal field. You can apply apply a wildcard <code class="code-span">*</code>
        as a substitute for zero or more characters.<br /><br /> <em>Example:</em>
        to find images from DeviantArt, you would use
        <code class="code-span">source_url:*deviantart.com*</code>
        .
      </div>
    </div>
  </div>
  <div class="hidden" id="js-search-tags">
    <div class="block" data-target=".js-search-field">
      {PhilomenaWeb.TagView.quick_tags(@conn)}
    </div>
  </div>
  <div class="flex flex-wrap items-center gap-md">
    {submit("Search", class: "button button-primary")}
    <% sf = input_value(f, :sf)
    random_is_selected = to_string(sf) =~ ~r/\Arandom(:\d+)?\z/

    random_seed =
      if random_is_selected do
        sf
      else
        "random:#{:rand.uniform(4_294_967_296)}"
      end

    sort_fields = [
      "Sort by initial post date": :first_seen_at,
      "Sort by image ID": :id,
      "Sort by last modification date": :updated_at,
      "Sort by aspect ratio": :aspect_ratio,
      "Sort by fave count": :faves,
      "Sort by upvotes": :upvotes,
      "Sort by downvotes": :downvotes,
      "Sort by score": :score,
      "Sort by Wilson score": :wilson_score,
      "Sort by hides": :hides,
      "Sort by relevance": :_score,
      "Sort by width": :width,
      "Sort by height": :height,
      "Sort by comments": :comment_count,
      "Sort by tag count": :tag_count,
      "Sort by pixels": :pixels,
      "Sort by file size": :size,
      "Sort by duration": :duration,
      Random!: random_seed
    ]

    sort_directions = [
      Descending: :desc,
      Ascending: :asc
    ]

    sort_hidden = [
      "Exclude Deleted": "",
      "Include Deleted/Merged": "1",
      "Deleted Only": "deleted",
      "Deleted/Merged Only": "only"
    ] %>
    {select_field(f, :sf, sort_fields, autocomplete: "off")}{select_field(f, :sd, sort_directions,
      autocomplete: "off"
    )}
    <%= if present?(input_value(f, :hidden)) do %>
      {hidden_input(f, :hidden)}
    <% end %>
    <%= if hides_images?(@conn) do %>
      {select_field(f, :del, sort_hidden, autocomplete: "off")}
    <% end %>
  </div>
<% end %>
