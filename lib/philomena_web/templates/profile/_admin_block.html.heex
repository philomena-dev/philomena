<div class="card">
  <i class="fa fa-fw fa-calendar"></i>
  Account created {@user.created_at}<br /><i class="fa fa-fw fa-filter"></i>
  Current Filter:
  <%= if @filter do %>
    {link(@filter.name, to: ~p"/filters/#{@filter}")}
  <% else %>
    <em>(none)</em>
  <% end %>
  <br /><i class="far fa-fw fa-clock"></i>
  Last seen
  <%= if @last_ip do %>
    {pretty_time(@last_ip.updated_at)} from {link_to_ip(@conn, @last_ip.ip)}
    <%= if @last_fingerprint do %>
      {link_to_fingerprint(@conn, @last_fingerprint.fingerprint)}
    <% end %>
  <% else %>
    <em>(never)</em>
  <% end %>
  <br /><i class="fas fa-fw fa-key"></i>
  Two factor auth: <strong>{enabled_text(@user.otp_required_for_login)}</strong><br />
  <%= if @user.locked_at do %>
    <i class="fas fa-fw fa-lock"></i>
    <strong class="text-danger">Account locked, {@user.failed_attempts} failed login attempts</strong>
  <% else %>
    <i class="fas fa-fw fa-unlock"></i> Not currently locked
  <% end %>
</div>
<br /><a
  class="button button-size-badge"
  data-click-toggle=".js-admin__options__toggle"
  href="#"
  title="Toggle Controls"
><i class="fa fa-fw fa-bars"></i><span>Toggle Controls</span></a>
<div class="flex flex-wrap gap-x-xl mt-md js-admin__options__toggle hidden">
  <nav class="nav">
    <%= link to: ~p"/search?#{[q: "upvoted_by_id:#{@user.id}"]}", class: "nav-link" do %>
      <i class="fa fa-fw fa-arrow-up"></i> Upvotes
    <% end %>
    <%= link to: ~p"/search?#{[q: "downvoted_by_id:#{@user.id}"]}", class: "nav-link" do %>
      <i class="fa fa-fw fa-arrow-down"></i> Downvotes
    <% end %>
    <%= link to: ~p"/search?#{[q: "hidden_by_id:#{@user.id}"]}", class: "nav-link" do %>
      <i class="fa fa-fw fa-eye-slash"></i> Hidden Images
    <% end %>
    <%= link to: ~p"/admin/reports?#{[rq: [query: "user_id:#{@user.id}"]]}", class: "nav-link" do %>
      <i class="fa fa-fw fa-exclamation"></i> Reports
    <% end %>
    <%= link to: ~p"/profiles/#{@user}/ip_history", class: "nav-link" do %>
      <i class="fab fa-fw fa-internet-explorer"></i> IP History
    <% end %>
    <%= link to: ~p"/profiles/#{@user}/fp_history", class: "nav-link" do %>
      <i class="fa fa-fw fa-desktop"></i> FP History
    <% end %>
    <%= link to: ~p"/profiles/#{@user}/aliases", class: "nav-link" do %>
      <i class="fa fa-fw fa-users"></i> Potential Aliases
    <% end %>
    <%= if can?(@conn, :show, Philomena.Donations.Donation) do %>
      <%= link to: ~p"/admin/donations/user/#{@user}", class: "nav-link" do %>
        <i class="fas fa-fw fa-dollar-sign"></i> Donations
      <% end %>
    <% end %>
  </nav>
  <nav class="nav">
    <%= if can?(@conn, :edit, @user) do %>
      <%= link to: ~p"/admin/users/#{@user}/edit", class: "nav-link" do %>
        <i class="fas fa-fw fa-edit"></i> Edit User
      <% end %>
    <% end %>
    <%= if can?(@conn, :force_filter, @user) do %>
      <%= link to: ~p"/admin/users/#{@user}/force_filter/new", class: "nav-link" do %>
        <i class="fas fa-fw fa-filter"></i> Force Filter
      <% end %>
    <% end %>
    <%= if @forced && can?(@conn, :unforce_filter, @user) do %>
      <%= link to: ~p"/admin/users/#{@user}/force_filter", data: [confirm: "Are you really, really sure?", method: "delete"], class: "nav-link" do %>
        <i class="fas fa-fw fa-filter"></i> Remove Force Filter
      <% end %>
    <% end %>
    <%= if @user.deleted_at do %>
      <%= if can?(@conn, :reactivate, @user) do %>
        <%= link to: ~p"/admin/users/#{@user}/activation", data: [confirm: "Are you really, really sure?", method: "post"], class: "nav-link" do %>
          <i class="fa fa-fw fa-check"></i> Reactivate Account
        <% end %>
      <% end %>
    <% else %>
      <%= if can?(@conn, :deactivate, @user) do %>
        <%= link to: ~p"/admin/users/#{@user}/activation", data: [confirm: "Are you really, really sure?", method: "delete"], class: "nav-link" do %>
          <i class="fa fa-fw fa-times"></i> Deactivate Account
        <% end %>
      <% end %>
    <% end %>
    <%= if @user.locked_at && can?(@conn, :unlock, @user) do %>
      <%= link to: ~p"/admin/users/#{@user}/unlock", data: [method: "post"], class: "nav-link" do %>
        <i class="fas fa-fw fa-unlock"></i> Unlock Account
      <% end %>
    <% end %>
    <%= if can?(@conn, :wipe, @user) do %>
      <%= link to: ~p"/admin/users/#{@user}/wipe", data: [confirm: "This is irreversible, destroying all identifying information including email. Are you sure?", method: "post"], class: "nav-link" do %>
        <i class="fas fa-fw fa-eraser"></i> Wipe PII
      <% end %>
    <% end %>
    <%= if can?(@conn, :create_links, @user) do %>
      <%= link to: ~p"/profiles/#{@user}/artist_links/new", class: "nav-link" do %>
        <i class="fa fa-fw fa-link"></i> Add Artist Link
      <% end %>
    <% end %>
    <%= if can?(@conn, :create, Philomena.Bans.User) do %>
      <%= link to: ~p"/admin/user_bans/new?#{[user_id: @user.id]}", class: "nav-link" do %>
        <i class="fa fa-fw fa-ban"></i> Ban this sucker
      <% end %>
    <% end %>
  </nav>
  <nav class="nav">
    <%= if can?(@conn, :reset_api_key, @user) do %>
      <%= link to: ~p"/admin/users/#{@user}/api_key", data: [confirm: "Are you really, really sure?", method: "delete"], class: "nav-link" do %>
        <i class="fas fa-fw fa-key"></i> Reset API key
      <% end %>
    <% end %>
    <%= if @user.verified do %>
      <%= if can?(@conn, :unverify, @user) do %>
        <%= link to: ~p"/admin/users/#{@user}/verification", data: [confirm: "Are you really, really sure?", method: "delete"], class: "nav-link" do %>
          <i class="fas fa-fw fa-user-times"></i> Revoke Verification
        <% end %>
      <% end %>
    <% else %>
      <%= if can?(@conn, :verify, @user) do %>
        <%= link to: ~p"/admin/users/#{@user}/verification", data: [confirm: "Are you really, really sure?", method: "post"], class: "nav-link" do %>
          <i class="fas fa-fw fa-user-check"></i> Grant Verification
        <% end %>
      <% end %>
    <% end %>
  </nav>
  <nav class="nav">
    <%= if @user.role == "user" and not @user.verified and can?(@conn, :erase, @user) do %>
      <%= link to: ~p"/admin/users/#{@user}/erase/new", class: "nav-link" do %>
        <i class="fa fa-fw fa-warning"></i> Erase for spam
      <% end %>
    <% end %>
    <%= if can?(@conn, :wipe_votes, @user) do %>
      <%= link to: ~p"/admin/users/#{@user}/votes", data: [confirm: "Are you really, really sure?", method: "delete"], class: "nav-link" do %>
        <i class="far fa-fw fa-file-excel"></i> Remove All Votes/Faves
      <% end %>
    <% end %>
    <%= if can?(@conn, :wipe_downvotes, @user) do %>
      <%= link to: ~p"/admin/users/#{@user}/downvotes", data: [confirm: "Are you really, really sure?", method: "delete"], class: "nav-link" do %>
        <i class="fa fa-fw fa-arrow-down"></i> Remove All Downvotes
      <% end %>
    <% end %>
    <%= if @user.role == "user" and can?(@conn, :revert, Philomena.TagChanges.TagChange) do %>
      <%= link to: ~p"/profiles/#{@user}/tag_changes/revert", data: [confirm: "Are you really, really sure?", method: "create"], class: "nav-link" do %>
        <i class="fa fa-fw fa-tag"></i> Revert All Tag Changes
      <% end %>
    <% end %>
  </nav>
</div>
