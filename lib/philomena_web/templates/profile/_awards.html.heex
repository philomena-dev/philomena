<div class="awards" phx-no-format>
  <% awards = award_order(@awards) %>
  <% {awards, overflow} = Enum.split(awards, 10) %>
  <%= for award <- awards do %><% title = [award_title(award), award.label] |> Enum.join(" - ") %><div class="award">{badge_image(award.badge, alt: title, title: title, width: "18", height: "18")}</div><% end %><div :if={Enum.any?(overflow)} class="dropdown">
    <button aria-expanded="false" aria-haspopup="true" class="cursor-pointer" title="More badges" type="button"><i class="fa fa-caret-down"></i></button>
    <div class="dropdown-menu end">
      <div class="awards">
        <%= for award <- overflow do %><% title = [award_title(award), award.label] |> Enum.join(" - ") %><div class="award">{badge_image(award.badge, alt: title, title: title, width: "18", height: "18")}</div><% end %>
      </div>
    </div>
  </div>
</div>
