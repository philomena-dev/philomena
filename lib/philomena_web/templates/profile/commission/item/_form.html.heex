<%= form_for @changeset, @action, [class: "content"], fn f -> %>
  {error_summary(@changeset)}
  <div class="form-control">
    {label(f, :item_type, "Type of item:")} {select_field(f, :item_type, types())}{error_tag(
      f,
      :item_type
    )}
  </div>
  <br />
  <div class="form-control">
    {label(f, :base_price, "Base Price:")} {number_input(f, :base_price,
      class: "input-field",
      placeholder: "20.00",
      step: "any",
      min: 0
    )}{error_tag(f, :base_price)}
  </div>
  <br />
  <div class="form-control">
    {label(f, :example_image_id, "ID of example image:")} {number_input(f, :example_image_id,
      class: "input-field",
      placeholder: "1345604"
    )}{error_tag(f, :example_image_id)}
  </div>
  <br />
  <div class="form-control">
    {label(f, :description, "Short description:")} {text_input(f, :description,
      class: "input-field full-width",
      placeholder: "Description"
    )}{error_tag(f, :description)}
  </div>
  <br />
  <div class="form-control">
    {label(f, :add_ons, "Add-ons (optional):")} {textarea(f, :add_ons,
      class: "input-field full-width",
      rows: 6,
      placeholder: "Additional character: $10.00"
    )}{error_tag(f, :add_ons)}
  </div>
  <div class="form-control-submit">{submit("Submit", class: "button")}</div>
<% end %>
