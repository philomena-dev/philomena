<%= if @commission.sheet_image do %>
  <div class="block">
    <div class="block-header"><span class="block-header-title">Commissions Sheet</span></div>
    <div class="block-content text-center">
      {render(PhilomenaWeb.ImageView, "_image_container.html",
        image: @commission.sheet_image,
        size: :tall,
        conn: @conn
      )}
    </div>
  </div>
<% end %>
