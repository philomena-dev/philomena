<%= if Enum.any?(@comments) do %>
  <div class="block">
    <div class="block-header">
      <span class="block-header-title">Recent Comments</span><% true_prefix =
        if can_reveal_anon?(@conn), do: "true_", else: "" %>{link("View all",
        to: ~p"/comments?#{[cq: "#{true_prefix}author_id:#{@user.id}"]}"
      )}
    </div>
    <div class="block-content">
      <%= for {body, comment} <- @comments, can?(@conn, :show, comment.image) do %>
        {render(PhilomenaWeb.CommentView, "_comment.html",
          comment: comment,
          body: body,
          image: comment.image,
          conn: @conn
        )}
      <% end %>
    </div>
  </div>
<% end %>
