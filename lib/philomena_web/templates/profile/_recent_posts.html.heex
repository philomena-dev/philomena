<%= if Enum.any?(@posts) do %>
  <div class="block striped">
    <div class="block-header">
      <span class="block-header-title">Recent Forum Posts</span><% true_prefix =
        if can_reveal_anon?(@conn), do: "true_", else: "" %>{link("View all",
        to: ~p"/posts?#{[pq: "#{true_prefix}author_id:#{@user.id}"]}"
      )}
    </div>
    <%= for post <- @posts do %>
      <div class="block-content">
        Post {link(pretty_time(post.created_at),
          to:
            ~p"/forums/#{post.topic.forum}/topics/#{post.topic}?#{[post_id: post]}" <>
              "#post_#{post.id}"
        )} in topic {link(post.topic.title,
          to: ~p"/forums/#{post.topic.forum}/topics/#{post.topic}"
        )}
      </div>
    <% end %>
  </div>
<% end %>
