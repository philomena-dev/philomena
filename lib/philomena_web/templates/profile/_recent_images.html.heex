<%= if Enum.any?(@images) do %>
  <div class="block">
    <div class="block-header" phx-no-format>
      <span class="block-header-title">{@title}</span><%= if assigns[:view_all_path] do %>{link("View all", to: assigns[:view_all_path])}<% end %>
    </div>
    <div class="block-content media-list">
      <%= for image <- @images do %>
        {render(PhilomenaWeb.ImageView, "_image_box.html",
          image: image,
          size: :thumb,
          conn: @conn
        )}
      <% end %>
    </div>
  </div>
<% end %>
