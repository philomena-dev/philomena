<div class="block">
  <div class="block-header">
    <span class="block-header-title">Statistics (Last 90 Days)</span>
  </div>
  <div class="block-content">
    <div class="table-wrap responsive">
      <table class="table striped">
        <colgroup>
          <col class="profile-stat-name" />
          <col class="profile-stat-value" />
          <col class="profile-stat-sparkline" />
        </colgroup>
        <tbody>
          <tr>
            <td>Uploads</td>
            <td class="numeric">
              {number_with_delimiter(@user.images_count)}
            </td>
            <td>
              <div class="sparkline">{sparkline_data(@statistics.images_count)}</div>
            </td>
          </tr>
          <tr>
            <td>Favorites</td>
            <td class="numeric">
              {number_with_delimiter(@user.image_faves_count)}
            </td>
            <td>
              <div class="sparkline">{sparkline_data(@statistics.image_faves_count)}</div>
            </td>
          </tr>
          <tr>
            <td>Comments</td>
            <td class="numeric">
              {number_with_delimiter(@user.comments_count)}
            </td>
            <td>
              <div class="sparkline">{sparkline_data(@statistics.comments_count)}</div>
            </td>
          </tr>
          <tr>
            <td>Votes</td>
            <td class="numeric">
              {number_with_delimiter(@user.image_votes_count)}
            </td>
            <td>
              <div class="sparkline">{sparkline_data(@statistics.image_votes_count)}</div>
            </td>
          </tr>
          <tr>
            <td>Metadata Updates</td>
            <td class="numeric">
              {number_with_delimiter(@user.metadata_updates_count)}
            </td>
            <td>
              <div class="sparkline">{sparkline_data(@statistics.metadata_updates_count)}</div>
            </td>
          </tr>
          <tr>
            <td>Forum Posts</td>
            <td class="numeric">
              {number_with_delimiter(@user.posts_count)}
            </td>
            <td>
              <div class="sparkline">{sparkline_data(@statistics.posts_count)}</div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
