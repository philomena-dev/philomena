<div class="block-content markdown">
  <%= cond do %>
    <% @user.description not in [nil, ""] -> %>
      {@about_me}
    <% current?(@user, @conn.assigns.current_user) -> %>
      <em>Want to {link("add some info about yourself?",
        to: ~p"/profiles/#{@user}/description/edit"
      )}</em>
    <% true -> %>
  <% end %>
</div>
