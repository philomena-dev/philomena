<%= if Enum.any?(@galleries) do %>
  <div class="block">
    <div class="block-header">
      <span class="block-header-title">Recent Galleries</span>{link("View all",
        to: ~p"/galleries?#{[gallery: [creator: @user.name]]}"
      )}
    </div>
    <div class="block-content media-list">
      <%= for gallery <- @galleries do %>
        {render(PhilomenaWeb.GalleryView, "_gallery.html", gallery: gallery, conn: @conn)}
      <% end %>
    </div>
  </div>
<% end %>
