<% target = @notification.target %>
<% source = @notification.source %>
<div class="flex flex--centered flex__fixed thumb-tiny-container spacing-right">{render PhilomenaWeb.ImageView, "_image_container.html", image: target, size: :thumb_tiny, conn: @conn}</div>
<div class="flex flex--centered flex__grow">
  <div>Someone merged #{source.id} into <strong>{link "##{target.id}", to: ~p"/images/#{target}" <> "#comments"}</strong> {pretty_time @notification.updated_at} </div>
</div>
<div class="flex flex--centered flex--no-wrap"><a class="button button--separate-right" data-click-hideparent=".notification" data-method="post" data-remote="true" href={~p"/images/#{target}/read"} title="Delete"><i class="fa fa-trash"></i></a><a class="button" data-click-hideparent=".notification" data-method="delete" data-remote="true" href={~p"/images/#{target}/subscription"} title="Unsubscribe"><i class="fa fa-bell-slash"></i></a></div>
