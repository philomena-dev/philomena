<% target = @notification.target %>
<% source = @notification.source %>
{render(PhilomenaWeb.ImageView, "_image_container.html",
  image: target,
  size: :thumb_tiny,
  class: "me-lg",
  conn: @conn
)}
<div class="flex items-center flex-1">
  <div>
    Someone merged #{source.id} into
    <strong>{link("##{target.id}", to: ~p"/images/#{target}" <> "#comments")}</strong> {pretty_time(
      @notification.updated_at
    )}
  </div>
</div>
<div class="flex items-center flex-nowrap">
  <a
    class="button me-md"
    data-click-hideparent=".notification"
    data-method="post"
    data-remote="true"
    href={~p"/images/#{target}/read"}
    title="Delete"
  ><i class="fa fa-trash"></i></a><a
    class="button"
    data-click-hideparent=".notification"
    data-method="delete"
    data-remote="true"
    href={~p"/images/#{target}/subscription"}
    title="Unsubscribe"
  ><i class="fa fa-bell-slash"></i></a>
</div>
