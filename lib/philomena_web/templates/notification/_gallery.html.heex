<% gallery = @notification.gallery %>
<div class="flex flex--centered flex__grow">
  <div>
    {render(PhilomenaWeb.UserAttributionView, "_anon_user.html", object: gallery, conn: @conn)} added images to
    <strong>{link(gallery.title, to: ~p"/galleries/#{gallery}")}</strong> {pretty_time(
      @notification.updated_at
    )}
  </div>
</div>
<div class="flex flex--centered flex--no-wrap">
  <a
    class="button button--separate-right"
    data-click-hideparent=".notification"
    data-method="post"
    data-remote="true"
    href={~p"/galleries/#{gallery}/read"}
    title="Delete"
  ><i class="fa fa-trash"></i></a><a
    class="button"
    data-click-hideparent=".notification"
    data-method="delete"
    data-remote="true"
    href={~p"/galleries/#{gallery}/subscription"}
    title="Unsubscribe"
  ><i class="fa fa-bell-slash"></i></a>
</div>
