<% topic = @notification.topic %>
<% forum = topic.forum %>
<div class="flex flex--centered flex__grow">
  <div>
    {render(PhilomenaWeb.UserAttributionView, "_anon_user.html", object: topic, conn: @conn)} posted a new topic titled
    <strong>{link(topic.title, to: ~p"/forums/#{forum}/topics/#{topic}")}</strong>
    in {link(forum.name, to: ~p"/forums/#{forum}")} {pretty_time(@notification.updated_at)}
  </div>
</div>
<div class="flex flex--centered flex--no-wrap">
  <a
    class="button button--separate-right"
    data-click-hideparent=".notification"
    data-method="post"
    data-remote="true"
    href={~p"/forums/#{forum}/topics/#{topic}/read"}
    title="Delete"
  ><i class="fa fa-trash"></i></a>
</div>
