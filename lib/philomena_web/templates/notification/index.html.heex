<h1>Notification Area</h1>
<%= for {category, notifications} <- @notifications, Enum.any?(notifications) do %>
  <div class="block">
    <div class="block-header">
      <span class="block-header-title">{name_of_category(category)}</span>
    </div>
    <%= for notification <- notifications do %>
      <div class="block-content flex notification">
        {render(PhilomenaWeb.NotificationView, notification_template_path(category),
          notification: notification,
          conn: @conn
        )}
      </div>
    <% end %>
    <div class="block-header sub">
      <a href={~p"/notifications/categories/#{category}"}>View category ({notifications.total_entries})</a>
    </div>
  </div>
<% end %>
<p>
  To get notifications on new comments and forum posts, click the 'Subscribe' button in the bar at the top of an image or forum topic. You'll get notifications here for any new posts or comments.
</p>
