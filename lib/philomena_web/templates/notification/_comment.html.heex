<% comment = @notification.comment %>
<% image = @notification.image %>
{render(PhilomenaWeb.ImageView, "_image_container.html",
  image: image,
  size: :thumb_tiny,
  class: "me-lg",
  conn: @conn
)}
<div class="flex items-center flex-1 wrap-anywhere">
  <div>
    {render(PhilomenaWeb.UserAttributionView, "_anon_user.html", object: comment, conn: @conn)} commented on
    <strong>{link("##{image.id}", to: ~p"/images/#{image}" <> "#comments")}</strong> {pretty_time(
      @notification.updated_at
    )}
  </div>
</div>
<div class="flex items-center flex-nowrap">
  <a
    class="button me-md"
    data-click-hideparent=".notification"
    data-method="post"
    data-remote="true"
    href={~p"/images/#{image}/read"}
    title="Delete"
  ><i class="fa fa-trash"></i></a><a
    class="button"
    data-click-hideparent=".notification"
    data-method="delete"
    data-remote="true"
    href={~p"/images/#{image}/subscription"}
    title="Unsubscribe"
  ><i class="fa fa-bell-slash"></i></a>
</div>
