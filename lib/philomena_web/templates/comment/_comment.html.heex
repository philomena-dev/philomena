<% staff? = can?(@conn, :hide, @comment) %>
<article
  class={["communication allow-overflow", @comment.hidden_from_users && "deleted"]}
  id={"comment_#{@comment.id}"}
>
  <div :if={not @comment.approved and not @comment.hidden_from_users} class="communication-notice">
    <span><i class="fas fa-exclamation-triangle"></i>
    This comment is pending approval from a staff member.</span>
    <%= if can?(@conn, :approve, @comment) do %>
      <div class="button-group separated button-size-badge">
        <%= link(to: ~p"/images/#{@comment.image_id}/comments/#{@comment}/approve", data: [confirm: "Are you sure?"], method: "post", class: "button") do %>
          <i class="fas fa-check"></i> Approve
        <% end %>
        <a
          class="button togglable-delete-form-link"
          data-click-toggle={"#inline-reject-form-comment-#{@comment.id}"}
          href="#"
        ><i class="fa fa-times"></i> Reject</a>
      </div>
      <%= form_for :comment, ~p"/images/#{@comment.image_id}/comments/#{@comment}/hide", [class: "togglable-delete-form hidden flex", id: "inline-reject-form-comment-#{@comment.id}"], fn f -> %>
        {text_input(f, :deletion_reason,
          class: "input-field full-width",
          placeholder: "Deletion Reason",
          id: "inline-reject-reason-comment-#{@comment.id}",
          required: true
        )}{submit("Delete", class: "button")}
      <% end %>
    <% end %>
  </div>
  <div :if={@comment.hidden_from_users} class="communication-notice">
    <span>Deletion reason: {@comment.deletion_reason}</span>
    <span :if={staff? and @comment.destroyed_content}>This comment's contents have been destroyed.</span>
    <span :if={staff? and not is_nil(@comment.deleted_by)} class="communication-notice-by">
      {@comment.deleted_by.name}
    </span>
  </div>
  {render(PhilomenaWeb.CommunicationView, "_body.html",
    object: @comment,
    image: assigns[:image],
    text:
      if(not @comment.hidden_from_users or (staff? and not @comment.destroyed_content),
        do: @body
      ),
    conn: @conn
  )}
  {render(PhilomenaWeb.CommentView, "_comment_options.html", comment: @comment, conn: @conn)}
</article>
