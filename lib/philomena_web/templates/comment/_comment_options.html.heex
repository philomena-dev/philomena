<% staff? = can?(@conn, :hide, @comment)
deletable? = not @comment.hidden_from_users and not @comment.destroyed_content
link_path = ~p"/images/#{@comment.image}" <> "#comment_#{@comment.id}"
safe_author = PhilomenaWeb.PostView.markdown_safe_author(@comment)
quote_body = if @comment.hidden_from_users, do: "", else: @comment.body %>
<div class="communication-options">
  <div>
    <span>Posted {pretty_time(@comment.created_at)}</span>
    <a href={~p"/images/#{@comment.image}/comments/#{@comment}/reports/new"}>
      <i class="fa fa-flag"></i> Report
    </a>
    <%= if staff? do %>
      <%= if @comment.hidden_from_users and not @comment.destroyed_content do %>
        <%= link(to: ~p"/images/#{@comment.image_id}/comments/#{@comment}/hide", data: [confirm: "Are you sure?"], method: "delete", class: "staff-action") do %>
          <i class="fas fa-check"></i> Restore
        <% end %>
        <%= if can?(@conn, :delete, @comment) do %>
          <%= link(to: ~p"/images/#{@comment.image_id}/comments/#{@comment}/delete", data: [confirm: "Are you sure?"], method: "post", class: "staff-action") do %>
            <i class="fas fa-times"></i> Delete Contents
          <% end %>
        <% end %>
      <% end %>
      <a
        :if={deletable?}
        class="staff-action js-togglable-delete-form-link"
        data-click-toggle={"#inline-del-form-comment-#{@comment.id}"}
        href="#"
      ><i class="fas fa-times"></i> Delete</a>
      <%= if can?(@conn, :show, :identity_metadata) do %>
        <span class="staff-action">{link_to_ip(@conn, @comment.ip)}</span>
        <span class="staff-action">{link_to_fingerprint(@conn, @comment.fingerprint)}</span>
      <% end %>
    <% end %>
    <a
      :if={not is_nil(@comment.edited_at) and can?(@conn, :show, @comment)}
      class="communication-edited"
      href={~p"/images/#{@comment.image}/comments/#{@comment}/history"}
    >
      <span>
        Edited {pretty_time(@comment.edited_at)}
        <%= if @comment.edit_reason not in [nil, ""] do %>
          because: {@comment.edit_reason}
        <% end %>
      </span>
    </a>
  </div>
  <div>
    <a href={link_path} title="Link to comment"><i class="fa fa-link"></i> Link</a>
    <a
      class="js-post-reply"
      data-author={safe_author}
      data-post={quote_body}
      data-reply-url={link_path}
      href={link_path}
    ><i class="fa fa-quote-right"></i> Quote</a>
    <a class="js-post-reply" data-author={safe_author} data-reply-url={link_path} href={link_path}>
      <i class="fa fa-reply"></i> Reply
    </a>
    <a
      :if={can?(@conn, :edit, @comment)}
      href={~p"/images/#{@comment.image}/comments/#{@comment}/edit"}
    >
      <i class="fas fa-edit"></i> Edit
    </a>
  </div>
  <%= if staff? and deletable? do %>
    <%= form_for :comment, ~p"/images/#{@comment.image_id}/comments/#{@comment}/hide", [class: "js-togglable-delete-form hidden flex staff-action", id: "inline-del-form-comment-#{@comment.id}"], fn f -> %>
      {text_input(f, :deletion_reason,
        class: "input-field full-width",
        placeholder: "Deletion Reason",
        id: "inline-del-reason-comment-#{@comment.id}",
        required: true
      )}{submit("Delete", class: "button")}
    <% end %>
  <% end %>
</div>
