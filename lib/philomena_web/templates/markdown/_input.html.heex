<% form = assigns[:f] %>
<% action_text = assigns[:action_text] || "Edit" %>
<% action_icon = assigns[:action_icon] || "edit" %>
<% field_name = assigns[:name] || :body %>
<% field_placeholder = assigns[:placeholder] || "Your message" %>
<% is_required = assigns[:required] %>
<% input_classes = assigns[:class] %>
<div class="tabs">
  <a class="tab selected" data-click-tab="write" href="#"><i class={"fa #{"fa-#{action_icon}"}"}></i> {action_text}</a><a
    class="tab"
    data-click-tab="preview"
    href="#"
  ><i
    class="fa fa-cog fa-fw fa-spin js-preview-loading hidden"
    title={raw("Loading preview&hellip;")}
  ></i> <i class="fa fa-eye fa-fw js-preview-idle"></i>
  Preview</a>
</div>
<div class="tab-panel selected" data-tab="write">
  {render(PhilomenaWeb.MarkdownView, "_help.html", conn: @conn)}
  <div class="editor">
    {render(PhilomenaWeb.MarkdownView, "_toolbar.html", conn: @conn)}{textarea(form, field_name,
      class: add_classes("editor-input js-toolbar-input js-preview-input", input_classes),
      placeholder: field_placeholder,
      required: required?(is_required)
    )}
  </div>
  {error_tag(form, field_name)}
</div>
<div class="tab-panel js-preview-content" data-tab="preview"></div>
