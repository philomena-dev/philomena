<% route = @pagination_route %>
<% pagination =
  render(PhilomenaWeb.PaginationView, "_pagination.html",
    page: @tag_changes,
    route: route,
    conn: @conn,
    params: scope(@conn)
  ) %>
<h1>{@title}</h1>
<%= form_for @conn, @path, [method: "get", enforce_utf8: false, class: "content"], fn f -> %>
  <div class="flex flex-wrap items-start gap-md">
    <div class="form-input-group flex-1">
      {text_input(f, :tcq,
        class: "input-field",
        placeholder: "Search tag changes",
        autocapitalize: "none",
        autocomplete: if(@conn.cookies["enable_search_ac"], do: "on", else: "off"),
        inputmode: "search",
        data: [autocomplete: "multi-tags", autocomplete_condition: "enable_search_ac"]
      )}{submit("Search", class: "button button-primary")}
    </div>
    <% sort_fields = [
      "Sort by date": "created_at",
      "Sort by tag count": "tag_count",
      "Sort by added tag count": "added_tag_count",
      "Sort by removed tag count": "removed_tag_count"
    ]

    sort_directions = [Descending: "desc", Ascending: "asc"] %>
    {select_field(f, :sf, sort_fields)} {select_field(f, :sd, sort_directions)}
  </div>
  <div class="form-message form-message-description">
    For more information, see the <a href="/pages/search_syntax">search syntax documentation</a>. Wildcards are supported in all literal fields.
  </div>
  <br />
<% end %>
<%= form_for :tag_changes, ~p"/tag_changes/revert", [class: "content js-tag-changes-form"], fn _f -> %>
  <div class="block allow-overflow">
    <div :if={multiple_pages?(@tag_changes)} class="block-header">
      {pagination}
    </div>
    <%= if reverts_tag_changes?(@conn) do %>
      <div class="block-header sub">
        <a data-click-checkall=".js-tag-changes-form"><i class="fa fa-check"></i> Toggle all</a>
      </div>
    <% end %>
    <div class="block-content tag-change-list">
      <div class="card card-warning">
        <h4>
          <i class="fa fa-triangle-exclamation"></i>
          <strong>Do not undo staff member tag changes!</strong>
        </h4>
        <p>
          Ask them if you believe their changes are wrong. Staff members usually have a good reason to change tags. There might also be additional context, which you either can't see, or simply are unaware of.
        </p>
      </div>
      <%= for tag_change <- @tag_changes do %>
        <% {added_tags, removed_tags} = split_tags(tag_change) %>
        <% added_tags_count = Enum.count(added_tags) %>
        <% removed_tags_count = Enum.count(removed_tags) %>
        <% non_retained = non_retained_tags(tag_change) %>
        <div class={["tag-change", user_block_class(tag_change)]}>
          <%= unless assigns[:hide_image] do %>
            <div class="tag-change-image">
              {render(PhilomenaWeb.ImageView, "_image_container.html",
                image: tag_change.image,
                size: :thumb_tiny,
                conn: @conn
              )}
            </div>
          <% end %>
          <div class="flex-1">
            <div class="tag-change-header">
              <div class="tag-change-info">
                {render(PhilomenaWeb.UserAttributionView, "_anon_user.html",
                  object: tag_change,
                  conn: @conn
                )}
                <%= if staff?(tag_change) do %>
                  <span class="badge badge-success">
                    <span><i class="fa fa-gavel"></i> Staff Member</span>
                  </span>
                <% end %>
                <div class="flex-1 hidden-below-md"></div>
                <span>{pretty_time(tag_change.created_at)}</span>
                <div class="badge-group">
                  <%= if added_tags_count > 0 do %>
                    <span class="badge badge-success">
                      <span><i class="fa fa-plus"></i> {added_tags_count} tag(s)</span>
                    </span>
                  <% end %>
                  <%= if removed_tags_count > 0 do %>
                    <span class="badge badge-danger">
                      <span><i class="fa fa-minus"></i> {removed_tags_count} tag(s)</span>
                    </span>
                  <% end %>
                </div>
              </div>
            </div>
            <div class="tag-change-tags">
              <%= if added_tags_count > 0 do %>
                <div class="tag-change-added">
                  <i class="fa fa-plus"></i>
                  <div class="tag-list">
                    <%= for tag <- added_tags do %>
                      <div class={non_retained_class(non_retained, tag)}>
                        {render(PhilomenaWeb.TagView, "_tag.html", tag: tag, conn: @conn)}
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>
              <%= if removed_tags_count > 0 do %>
                <div class="tag-change-removed">
                  <i class="fa fa-minus"></i>
                  <div class="tag-list">
                    <%= for tag <- removed_tags do %>
                      <div class={non_retained_class(non_retained, tag)}>
                        {render(PhilomenaWeb.TagView, "_tag.html", tag: tag, conn: @conn)}
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
            <%= if reverts_tag_changes?(@conn) or can?(@conn, :show, :identity_metadata) do %>
              <div class="tag-change-tools">
                <%= if can?(@conn, :show, :identity_metadata) do %>
                  {link_to_ip(@conn, tag_change.ip)} {link_to_fingerprint(
                    @conn,
                    tag_change.fingerprint
                  )}
                <% end %>
                <%= if reverts_tag_changes?(@conn) do %>
                  <div class="flex flex-1"></div>
                  <a
                    class="button button-danger"
                    data-confirm="Are you really, really sure?"
                    data-method="delete"
                    href={~p"/tag_changes/#{tag_change}"}
                  ><i class="fa fa-trash"></i>
                  <span class="hidden-below-md">Delete from history</span><span class="hidden-from-md">Delete</span></a>
                  {checkbox_field(:tag_change, :revert, "Revert",
                    id: "tag_change_revert_#{tag_change.id}",
                    name: "ids[]",
                    checked_value: tag_change.id,
                    hidden_input: false
                  )}
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
      <p>* Crossed out tags were reverted and thus are not retained</p>
    </div>
    <div :if={multiple_pages?(@tag_changes)} class="block-header sub">
      {pagination}
    </div>
  </div>
  <%= if reverts_tag_changes?(@conn) do %>
    {submit("Revert selected", class: "button", data: [confirm: "Are you really, really sure?"])}<br /><br />
  <% end %>
<% end %>
<h3>Allowed fields</h3>
<div class="table-wrap responsive">
  <table class="table striped">
    <thead>
      <tr>
        <th>Field Selector</th>
        <th>Type</th>
        <th>Description</th>
        <th>Example</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><code class="code-span">tag</code></td>
        <td>Literal</td>
        <td>
          Matches the name of the changed tag. You can also simply search for the tags without specifying the "tag" field. To search for an added/removed tag, use
          <code class="code-span">added_tag</code>
          or <code class="code-span">removed_tag</code>.
        </td>
        <td>
          <code class="code-span">{link("tag:safe", to: ~p"/tag_changes?#{[tcq: "tag:safe"]}")}</code>
          or <code class="code-span">{link "safe", to: ~p"/tag_changes?#{[tcq: "safe"]}"}</code>, also try
          <code class="code-span">{link("added_tag:safe",
            to: ~p"/tag_changes?#{[tcq: "added_tag:safe"]}"
          )}</code>
          and
          <code class="code-span">{link("removed_tag:safe",
            to: ~p"/tag_changes?#{[tcq: "removed_tag:safe"]}"
          )}</code>
        </td>
      </tr>
      <tr>
        <td><code class="code-span">tag_count</code></td>
        <td>Numeric Range</td>
        <td>
          Matches the number of changed tags in the tag change. To search for the number of added/removed tags, use
          <code class="code-span">added_tag_count</code>
          or <code class="code-span">removed_tag_count</code>.
        </td>
        <td>
          <code class="code-span">{link "tag_count.gte:3", to: ~p"/tag_changes?#{[tcq: "tag_count.gte:3"]}"}</code>, also try
          <code class="code-span">{link("added_tag_count.gte:3",
            to: ~p"/tag_changes?#{[tcq: "added_tag_count.gte:3"]}"
          )}</code>
          and
          <code class="code-span">{link("removed_tag_count.gte:3",
            to: ~p"/tag_changes?#{[tcq: "removed_tag_count.gte:3"]}"
          )}</code>
        </td>
      </tr>
      <tr>
        <td><code class="code-span">created_at</code></td>
        <td>Date/Time Range</td>
        <td>Matches the creation time of the tag change.</td>
        <td>
          <code class="code-span">{link("created_at.gte:1 month ago",
            to: ~p"/tag_changes?#{[tcq: "created_at.gte:1 month ago"]}"
          )}</code>
        </td>
      </tr>
      <tr>
        <td><code class="code-span">my</code></td>
        <td>Meta</td>
        <td>
          <code class="code-span">my:changes</code>
          matches the tag changes you've made if you are signed in.
        </td>
        <td>
          <code class="code-span">{link("my:changes", to: ~p"/tag_changes?#{[tcq: "my:changes"]}")}</code>
        </td>
      </tr>
      <tr>
        <td><code class="code-span">anonymous</code></td>
        <td>Boolean</td>
        <td>Matches tag changes made by anonymous users, or users without an account.</td>
        <td>
          <code class="code-span">{link("anonymous:true",
            to: ~p"/tag_changes?#{[tcq: "anonymous:true"]}"
          )}</code>
        </td>
      </tr>
      <tr>
        <td><code class="code-span">user</code></td>
        <td>Literal</td>
        <td>Matches the user who created the tag change.</td>
        <td>
          <code class="code-span">{link("user:LightningBolt",
            to: ~p"/tag_changes?#{[tcq: "user:LightningBolt"]}"
          )}</code>
        </td>
      </tr>
      <tr>
        <td><code class="code-span">user_id</code></td>
        <td>Literal</td>
        <td>Matches tag changes made by a specific user ID.</td>
        <td>
          <code class="code-span">{link("user_id:217932",
            to: ~p"/tag_changes?#{[tcq: "user_id:217932"]}"
          )}</code>
        </td>
      </tr>
    </tbody>
  </table>
</div>
