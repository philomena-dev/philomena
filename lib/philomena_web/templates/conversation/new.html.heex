<h1>New Conversation</h1>
<div class="block">
  <div class="block-header">
    {link("Conversations", to: ~p"/conversations")} &raquo;
    <span class="block-header-title">New Conversation</span>
  </div>
</div>
<%= if not @trusted? do %>
  <div class="card card-warning hidden js-hidden-warning">
    <h2>Warning!</h2>
    <p>
      <strong>Your account is too new, so your PM will need to be reviewed by staff members.</strong>
      This is because it contains an external image. If you are not okay with a moderator viewing this PM conversation, please consider linking the image instead of embedding it (change
      <code>![</code>
      to <code>[</code>).
    </p>
  </div>
<% end %>
<%= form_for @changeset, ~p"/conversations", [class: "content"], fn f -> %>
  {error_summary(@changeset)}
  <div class="form-control">
    <div class="form-message form-message-description">
      Specify any user's exact name here, case-sensitive
    </div>
    {text_input(f, :recipient,
      class: "input-field full-width",
      placeholder: "Recipient",
      required: true
    )}{error_tag(f, :to)}
  </div>
  <div class="form-control">
    {text_input(f, :title, class: "input-field full-width", placeholder: "Title", required: true)}{error_tag(
      f,
      :title
    )}
  </div>
  <div class="block">
    <%= inputs_for f, :messages, fn fm -> %>
      {render(PhilomenaWeb.MarkdownView, "_input.html",
        changeset: @changeset,
        conn: @conn,
        f: fm,
        action_icon: "pencil-alt",
        action_text: "Compose"
      )}
    <% end %>
    <div class="block-content communication-edit__actions">
      {submit("Send", class: "button", autocomplete: "off", data: [disable_with: "Sending..."])}
    </div>
  </div>
<% end %>
