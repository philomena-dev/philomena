<% tabs = Enum.with_index(@data["tabs"])
tab_modes = @data["tab_modes"] %>
<div class="tabs">
  <%= for {name, i} <- tabs do %>
    <a class={["tab", tab_class(i)]} data-click-tab={name} href="#">{name}</a>
  <% end %>
</div>
<%= for {name, i} <- tabs do %>
  <% tab_data = @data[name] %>
  <% tab_mode = tab_modes[name] %>
  <div class={["tab-panel quick-tag-table__tab", tab_class(i)]} data-tab={name}>
    {render(PhilomenaWeb.TagView, "_quick_tag_table_#{tab_mode}.html",
      tab: name,
      data: tab_data,
      shipping: @shipping,
      tags: @tags,
      conn: @conn
    )}
  </div>
<% end %>
