<%!-- The menu opens on hover once tags.ts has picked its items --%>
<div
  class="dropdown manual"
  data-tag-id={"#{@tag.id}"}
  data-tag-name={"#{@tag.name}"}
  data-tag-slug={"#{@tag.slug}"}
>
  <span class={tag_class(@tag)} aria-haspopup="true">
    <a class="tag-name" href={pretty_tag_path(@tag)} title={"#{@tag.short_description}"}>{@tag.name}</a>
    <span class="tag-count">{@tag.images_count}</span>
  </span>
  <%!-- tags.ts finds the menu items in this order --%>
  <div class="dropdown-menu">
    <a
      class="dropdown-item hidden"
      data-method="delete"
      data-remote="true"
      data-tag-action="unwatch"
      href={~p"/tags/#{@tag}/watch"}
    ><i class="dropdown-icon fa fa-fw fa-bookmark"></i>Unwatch</a>
    <a
      class="dropdown-item hidden"
      data-method="post"
      data-remote="true"
      data-tag-action="watch"
      href={~p"/tags/#{@tag}/watch"}
    ><i class="dropdown-icon fa fa-fw fa-bookmark"></i>Watch</a>
    <a
      class="dropdown-item hidden"
      data-method="delete"
      data-remote="true"
      data-tag-action="unspoiler"
      href={~p"/filters/spoiler?#{[tag: @tag]}"}
    ><i class="dropdown-icon fa fa-fw fa-eye-low-vision"></i>Unspoiler</a>
    <a
      class="dropdown-item hidden"
      data-method="post"
      data-remote="true"
      data-tag-action="spoiler"
      href={~p"/filters/spoiler?#{[tag: @tag]}"}
    ><i class="dropdown-icon fa fa-fw fa-eye-low-vision"></i>Spoiler</a>
    <a
      class="dropdown-item hidden"
      data-method="delete"
      data-remote="true"
      data-tag-action="unhide"
      href={~p"/filters/hide?#{[tag: @tag]}"}
    ><i class="dropdown-icon fa fa-fw fa-ban"></i>Unhide</a>
    <a
      class="dropdown-item hidden"
      data-method="post"
      data-remote="true"
      data-tag-action="hide"
      href={~p"/filters/hide?#{[tag: @tag]}"}
    ><i class="dropdown-icon fa fa-fw fa-ban"></i>Hide</a>
    <a class="dropdown-item hidden" href="/sessions/new">
      <i class="dropdown-icon fa fa-fw fa-right-to-bracket"></i>Sign in to Watch
    </a>
    <a class="dropdown-item hidden" href="/filters">
      <i class="dropdown-icon fa fa-fw fa-filter"></i>Filter
    </a>
  </div>
</div>
