<% textarea_options = [
  class:
    "input-field full-width tagsinput js-image-tags-input js-taginput js-taginput-plain js-taginput-#{@name}",
  placeholder: "Add tags separated with commas",
  autocomplete: "off"
]

html_options = Keyword.merge(textarea_options, assigns[:extra] || []) %>
<div class={"js-tag-block self-stretch #{"fancy-tag-#{@type}"}"}>
  {textarea(@f, @name, html_options)}
  <div
    class="js-taginput input-field full-width tagsinput hidden js-taginput-fancy"
    data-click-focus={".js-taginput-input.js-taginput-#{@name}"}
  >
    <input
      autocapitalize="none"
      autocomplete="off"
      class={"input-field #{"js-taginput-input js-taginput-#{@name}"}"}
      data-autocomplete="single-tag"
      data-autocomplete-max-suggestions="5"
      id={"taginput-fancy-#{@name}"}
      placeholder="add a tag"
      spellcheck="false"
      type="text"
    />
  </div>
</div>
<button
  class="button button-primary js-taginput-show"
  data-click-focus={".js-taginput-input.js-taginput-#{@name}"}
  data-click-hide=".js-taginput-plain,.js-taginput-show"
  data-click-show=".js-taginput-fancy,.js-taginput-hide"
>Fancy Editor</button><button
  class="hidden button button-primary js-taginput-hide"
  data-click-focus={".js-taginput-plain.js-taginput-#{@name}"}
  data-click-hide=".js-taginput-fancy,.js-taginput-hide"
  data-click-show=".js-taginput-plain,.js-taginput-show"
>Plain Editor</button>
