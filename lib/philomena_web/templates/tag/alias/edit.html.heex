<h1>Aliasing tag {@tag.name}</h1>
<%= form_for @changeset, ~p"/tags/#{@tag}/alias", [method: "put", class: "content"], fn f -> %>
  {error_summary(@changeset)}
  <div class="form-control">
    {label(f, :target_tag, "Alias target:")} {text_input(f, :target_tag,
      value: alias_target(@tag),
      class: "input-field"
    )}{error_tag(f, :target_tag)}{error_tag(f, :tag)}{error_tag(f, :aliased_tag)}
  </div>
  <div class="form-control-submit">{submit("Alias tag", class: "button")}</div>
<% end %>
<br />{button_to("Remove tag alias", ~p"/tags/#{@tag}/alias",
  method: "delete",
  class: "button",
  data: [confirm: "Are you really, really sure?", disable_with: raw("Saving&hellip;")]
)}<br />{link("Back", to: ~p"/tags/#{@tag}")}
