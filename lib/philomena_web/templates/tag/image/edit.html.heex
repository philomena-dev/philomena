<div class="flex gap-lg">
  <div class="flex-none">
    <div class="tag-info-image">
      <%= if @tag.image do %>
        <img alt="spoiler image" height="50" src={tag_image(@tag)} width="50" />
      <% else %>
        no spoiler image
      <% end %>
    </div>
  </div>
  <div class="flex-1">
    <div>
      <h1>Tag image</h1>
      <p>Add a new image or remove the existing one here.</p>
      <p>SVG is preferred.</p>
      <%= form_for @changeset, ~p"/tags/#{@tag}/image", [method: "put", multipart: true, class: "content"], fn f -> %>
        {error_summary(@changeset)}
        <h4>Select an image</h4>
        <div>
          <div class="upload-previews" id="js-image-upload-previews"></div>
          <p>Upload a file from your computer</p>
          <div class="form-control">
            {file_input(f, :image, class: "input-field js-scraper")}{error_tag(
              f,
              :image_mime_type
            )}
          </div>
          <div class="alert alert-warning hidden js-scraper"></div>
          <div class="form-control-submit">{submit("Update tag image", class: "button")}</div>
        </div>
      <% end %>
      <br />{button_to("Remove tag image", ~p"/tags/#{@tag}/image",
        method: "delete",
        class: "button",
        data: [confirm: "Are you really, really sure?"]
      )}
    </div>
    <br />{link("Back", to: ~p"/tags/#{@tag}")}
  </div>
</div>
