{
  "compilerOptions": {
    // `lib` is the ECMAScript level of the browsers in `.browserslistrc`: they
    // all have ES2021, the floor Safari lacks ES2022 (`Array.prototype.at`).
    //
    // Tests need `@types/node`, which pulls in more of the standard library
    // (`<reference lib="es2020" />` plus some `esnext` parts), so the IDE may
    // suggest features that the browsers lack. There seems to be no way to give
    // the IDE a separate tsconfig for application files, so the final build
    // uses `tsconfig.build.json`, which leaves out `vitest/globals` and `node`
    // and so checks that the app depends on nothing past this level. `npm run
    // lint` checks everything with this file, tests and build scripts included.
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "target": "ES2021",
    "types": ["vitest/globals", "node"],

    "paths": { "*": ["./js/*"] },
    "useDefineForClassFields": true,
    "esModuleInterop": true,
    "allowJs": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,

    // Checks that aren't enabled by `strict` and not covered by `oxlint`:
    "noImplicitOverride": true

    // TODO: this is a really useful check, but our existing code has been
    // written with so much unsafe indexing that needs some work to improve
    // before this can be enabled
    // "noUncheckedIndexedAccess": true
  },
  "include": ["./js/**/*", "./test/**/*", "./build/**/*", "./vite.config.ts"]
}
