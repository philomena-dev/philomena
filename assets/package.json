{
  "name": "philomena-assets",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "cross-env NODE_ENV=production tsc --project tsconfig.build.json && cross-env NODE_ENV=production vite build",
    "lint": "oxlint . && stylelint ./css/**/*.css",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch --coverage",
    "dev": "vite",
    "build": "tsc --project tsconfig.build.json && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@csstools/postcss-relative-color-syntax": "^4.0.16",
    "@csstools/selector-specificity": "^6.0.1",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@mdn/browser-compat-data": "^8.1.8",
    "@philomena/philomena-css": "*",
    "@types/postcss-mixins": "^9.0.6",
    "@types/web": "^0.0.360",
    "autoprefixer": "^10.6.2",
    "browserslist": "^4.29.5",
    "cross-env": "^10.1.0",
    "focus-visible": "^5.2.1",
    "postcss": "^8.5.32",
    "postcss-focus-visible": "^11.0.0",
    "postcss-logical": "^9.0.2",
    "postcss-mixins": "^12.1.2",
    "postcss-selector-parser": "^7.2.0",
    "postcss-simple-vars": "^7.0.1",
    "postcss-value-parser": "^4.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.0",
    "oxlint": "^1.91.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "vitest": "^5.1.0",
    "vitest-fetch-mock": "^0.4.5"
